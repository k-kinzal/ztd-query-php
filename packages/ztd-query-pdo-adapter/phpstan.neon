# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - fuzz
        - bench
    ignoreErrors:
        # PDO exposes these methods only on some supported runtimes. Override
        # on connect is fatal on PHP 8.3; the pgsql methods are dynamic PDO 8.1-8.3 methods.
        -
            identifier: customRules.overrideMustHaveAttribute
            message: '#^Add \#\[\\Override\] to override method (pgsqlCopy(ToArray|FromArray|ToFile|FromFile)|connect)\(\)\.$#'
            path: src/ZtdPdo.php
            count: 5
        # This existing public class name is retained for consumer compatibility.
        -
            identifier: customRules.forbiddenClassLikeNameSuffix
            path: src/PdoParameterType.php
            count: 1
        # PHPStan's PDO::connect dynamic return extension infers driver subclasses
        # even for this override; the runtime return is covered on PHP 8.1-8.5.
        -
            identifier: class.notFound
            path: tests/Unit/ZtdPdoTest.php
            count: 1
