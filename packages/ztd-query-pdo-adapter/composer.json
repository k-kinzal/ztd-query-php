{
    "name": "k-kinzal/ztd-query-pdo-adapter",
    "description": "PDO adapter for ZTD Query",
    "type": "library",
    "license": "MIT",
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/ztd-query-pdo-adapter",
        "docs": "https://k-kinzal.github.io/ztd-query-php/k-kinzal/ztd-query-pdo-adapter/"
    },
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "k-kinzal/ztd-query-core": "dev-main"
    },
    "require-dev": {
        "brianium/paratest": "^7.3",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.95.25",
        "k-kinzal/container": "dev-main",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "k-kinzal/sql-fixture": "dev-main",
        "k-kinzal/sql-parser": "dev-main",
        "k-kinzal/ztd-query-mysql": "dev-main",
        "k-kinzal/ztd-query-postgres": "dev-main",
        "k-kinzal/ztd-query-sqlite": "dev-main",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "suggest": {
        "k-kinzal/ztd-query-mysql": "Required for MySQL support (PDO driver: mysql)",
        "k-kinzal/ztd-query-postgres": "Required for PostgreSQL support (PDO driver: pgsql)",
        "k-kinzal/ztd-query-sqlite": "Required for SQLite support (PDO driver: sqlite)"
    },
    "repositories": [
        {
            "name": "sql-parser",
            "type": "path",
            "url": "../sql-parser",
            "options": {
                "versions": {
                    "k-kinzal/sql-parser": "dev-main"
                }
            }
        },
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        },
        {
            "type": "path",
            "url": "../sql-fixture",
            "options": {
                "versions": {
                    "k-kinzal/sql-fixture": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../ztd-query-core",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-core": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../ztd-query-mysql",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-mysql": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../ztd-query-postgres",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-postgres": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../ztd-query-sqlite",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-sqlite": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../container",
            "options": {
                "versions": {
                    "k-kinzal/container": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "ZtdQuery\\Adapter\\Pdo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Fuzz\\": "fuzz/",
            "Bench\\": "bench/"
        }
    },
    "scripts": {
        "autoload:check": "composer dump-autoload --optimize --strict-psr --strict-ambiguous",
        "bench": "phpbench run --report=aggregate",
        "bench:full": "@bench",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
        "compat": "phpcs",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered --report-uncovered",
        "docgen": "docgen --packages=. --title=k-kinzal/ztd-query-pdo-adapter",
        "docgen:diff": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --diff=origin/main --serve"
        ],
        "docgen:fresh": "@docgen --no-cache",
        "docgen:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --serve"
        ],
        "doctest": "phpunit --testsuite doctest",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "lint": [
            "@autoload:check",
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "loc-guard": "loc-guard --config=loc.yaml",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "paratest --processes=auto",
        "test:coverage": "@php -d memory_limit=1G vendor/bin/paratest --processes=auto --testsuite unit --coverage-xml build/coverage-xml --log-junit build/junit.xml",
        "test:integration": "phpunit --testsuite integration",
        "test:unit": "phpunit --testsuite unit",
        "tree-guard": "tree-guard --config=tree.yaml"
    },
    "scripts-descriptions": {
        "autoload:check": "Check that the PSR-4 autoload mapping is strict and unambiguous.",
        "bench": "Run the benchmarks.",
        "bench:full": "Run the benchmarks.",
        "bench:quick": "Run the benchmarks with fewer iterations.",
        "compat": "Check compatibility with PHP 8.1 and later with PHP_CodeSniffer.",
        "deptrac": "Check the layer dependencies with Deptrac.",
        "docgen": "Generate the API documentation into build/docs.",
        "docgen:diff": "Generate the API documentation marked with the changes against origin/main, and serve it.",
        "docgen:fresh": "Generate the API documentation without the cache.",
        "docgen:serve": "Generate the API documentation and serve it locally.",
        "doctest": "Run the @example blocks of the PHPDoc as tests.",
        "format": "Fix the code style with PHP-CS-Fixer.",
        "format:check": "Check the code style with PHP-CS-Fixer without changing files.",
        "lint": "Run every static check: autoload, formatting, PHPStan, PHP compatibility, size and tree guards, and layer dependencies.",
        "loc-guard": "Check file size limits.",
        "phpstan": "Run PHPStan.",
        "test": "Run all test suites in parallel.",
        "test:coverage": "Run the unit tests in parallel and write the coverage and JUnit reports to build/.",
        "test:integration": "Run the integration tests against a database.",
        "test:unit": "Run the unit tests.",
        "tree-guard": "Check the directory structure rules."
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
