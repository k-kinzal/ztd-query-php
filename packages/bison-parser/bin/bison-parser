#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloaders = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require_once $autoloader;
        break;
    }
}

use BisonParser\Parser;
use BisonParser\Printer\Printer;
use BisonParser\SyntaxException;

/**
 * Command line front door of bison-parser.
 *
 * Usage:
 *   bison-parser check FILE...   Read each file and report whether it is a grammar Bison would accept
 *   bison-parser stats FILE...   Count the declarations, rules and alternatives of each file
 *   bison-parser print FILE      Read a file and write it back out in the printer's layout
 */

/**
 * Reads a file or reports why it cannot be read.
 *
 * @param string $path Path of the grammar file
 *
 * @return string|null The contents, or null when the file cannot be read
 */
function readGrammar(string $path): ?string
{
    $contents = is_file($path) ? file_get_contents($path) : false;
    if ($contents === false) {
        fwrite(STDERR, "{$path}: cannot read the file\n");

        return null;
    }

    return $contents;
}

$command = $argv[1] ?? 'help';
$paths = array_slice($argv, 2);
if (!in_array($command, ['check', 'stats', 'print'], true) || $paths === []) {
    fwrite(STDERR, "Usage: bison-parser check|stats|print FILE...\n");
    exit(2);
}
$parser = new Parser();
$printer = new Printer();
$status = 0;
foreach ($paths as $path) {
    $source = readGrammar($path);
    if ($source === null) {
        $status = 1;
        continue;
    }
    try {
        $file = $parser->parse($source);
    } catch (SyntaxException $exception) {
        fwrite(STDERR, "{$path}: {$exception->getMessage()}\n");
        $status = 1;
        continue;
    }
    if ($command === 'print') {
        fwrite(STDOUT, $printer->print($file));
        continue;
    }
    $alternatives = 0;
    foreach ($file->rules() as $rule) {
        $alternatives += count($rule->alternatives);
    }
    if ($command === 'stats') {
        fwrite(STDOUT, sprintf("%s: %d declarations, %d rules, %d alternatives\n", $path, count($file->allDeclarations()), count($file->rules()), $alternatives));
        continue;
    }
    $printed = $printer->print($file);
    $stable = $printer->print($parser->parse($printed)) === $printed;
    fwrite(STDOUT, "{$path}: " . ($stable ? 'ok' : 'read, but printing it is not stable') . "\n");
    $status = $stable ? $status : 1;
}
exit($status);
