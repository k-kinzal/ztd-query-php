{
    "name": "k-kinzal/ztd-query-sqlite",
    "description": "SQLite platform support for ZTD Query",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "k-kinzal/ztd-query-core": "dev-main"
    },
    "require-dev": {
        "brianium/paratest": "^7.3",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.95.25",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "k-kinzal/sql-faker": "dev-main",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ztd-query-core",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-core": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../sql-faker",
            "options": {
                "versions": {
                    "k-kinzal/sql-faker": "dev-main"
                }
            }
        },
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "ZtdQuery\\Platform\\Sqlite\\": "src/"
        },
        "classmap": [
            "src/Binding/SqliteErrorClassifier.php",
            "src/Binding/SqlitePdoParameterBindingCompiler.php",
            "src/Binding/SqlitePdoResultColumnTypeResolver.php",
            "src/Parsing/SqliteInMemoryAttachStatement.php",
            "src/Parsing/SqliteLexerProfile.php",
            "src/Parsing/SqliteLexicalMasker.php",
            "src/Parsing/SqliteReadOnlyDiagnosticStatement.php",
            "src/Parsing/SqliteReturningProjectionParser.php",
            "src/Parsing/SqliteSelectRelationParser.php",
            "src/Parsing/SqliteTransactionStatementParser.php",
            "src/Parsing/SqliteUpsertExpressionParser.php",
            "src/Rewriting/Mutation/AlterTableMutation.php",
            "src/Rewriting/Rendering/SqliteCastRenderer.php",
            "src/Rewriting/Rendering/SqliteIdentifierQuoter.php",
            "src/Rewriting/Rendering/SqliteValueRenderer.php",
            "src/Rewriting/SqliteCteShadowComposer.php",
            "src/Rewriting/SqliteFullTextSearchRewriter.php",
            "src/Rewriting/SqliteGeneratedColumnProjector.php",
            "src/Rewriting/SqliteIndexHintStripper.php",
            "src/Rewriting/SqliteNativeUpsertProjector.php",
            "src/Rewriting/SqliteViewShadowRenderer.php",
            "src/Rewriting/Transformer/DeleteTransformer.php",
            "src/Rewriting/Transformer/InsertRowRenderer.php",
            "src/Rewriting/Transformer/InsertSelectRenderer.php",
            "src/Rewriting/Transformer/InsertTransformer.php",
            "src/Rewriting/Transformer/SelectTransformer.php",
            "src/Rewriting/Transformer/SqliteTransformer.php",
            "src/Rewriting/Transformer/UpdateTransformer.php",
            "src/Schema/SqliteColumnTypeMapper.php",
            "src/Schema/SqliteForeignKeyDefinitionParser.php",
            "src/Schema/SqliteViewDefinitionParser.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Fuzz\\": "fuzz/",
            "Bench\\": "bench/",
            "Tests\\Contract\\": "../ztd-query-core/tests/Contract/",
            "Tests\\Fake\\": "../ztd-query-core/tests/Fake/"
        }
    },
    "scripts": {
        "bench": "phpbench run --report=aggregate",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
        "bench:full": "@bench",
        "test": "paratest --processes=auto",
        "lint": [
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz": [
            "@fuzz:robustness:classify",
            "@fuzz:robustness:rewrite",
            "@fuzz:semantics"
        ],
        "fuzz:robustness": "@fuzz:semantics",
        "fuzz:robustness:classify": "php-fuzzer fuzz fuzz/fuzz_robustness_classify.php fuzz/corpus/robustness-classify/",
        "fuzz:robustness:rewrite": "php-fuzzer fuzz fuzz/fuzz_robustness_rewrite.php fuzz/corpus/robustness-rewrite/",
        "test:unit": "phpunit --testsuite unit",
        "test:fuzz": "@php -d memory_limit=512M vendor/bin/phpunit --testsuite fuzz",
        "doctest": "phpunit --testsuite doctest",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "compat": "phpcs",
        "loc-guard": "loc-guard --config=loc.yaml",
        "tree-guard": "tree-guard --config=tree.yaml",
        "deptrac": [
            "deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered",
            "deptrac debug:unassigned --config-file=deptrac.yaml"
        ],
        "deptrac:debug": [
            "deptrac debug:unassigned --config-file=deptrac.yaml",
            "deptrac debug:unused --config-file=deptrac.yaml"
        ],
        "docgen": "cd ../.. && packages/ztd-query-sqlite/vendor/bin/docgen --packages=packages/ztd-query-sqlite --deptrac=\"$(pwd)/packages/ztd-query-sqlite/deptrac.yaml\" --exclude='packages/ztd-query-sqlite/../ztd-query-core/tests/*' --output=packages/ztd-query-sqlite/build/docs --cache-dir=packages/ztd-query-sqlite/build/docgen-cache --title=k-kinzal/ztd-query-sqlite",
        "docgen:serve": "@docgen --serve",
        "docgen:diff": "@docgen --diff=origin/main --serve",
        "docgen:fresh": "@docgen --no-cache",
        "fuzz:semantics": "php-fuzzer fuzz fuzz/fuzz_semantics.php fuzz/corpus/semantics/"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/ztd-query-sqlite",
        "docs": "https://k-kinzal.github.io/ztd-query-php/sqlite/k-kinzal/ztd-query-sqlite/"
    }
}
