# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        visibilityExemptNamespacePrefixes:
            - 'Tests'
            - 'Bench'
            - 'Fuzz'
        forbiddenTermsByPath:
            'src/Automaton/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Compiler/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Grammar/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Lexer/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Parser/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Table/*': [mysql, postgres, pgsql, sqlite, mariadb]
        forbiddenNamespacePrefixes:
            - 'Tests\Fixture'
            - 'Tests\Fixtures'
    phpVersion: 80100
    level: max
    paths:
        - src
        - tests
        - fuzz
        - bench
