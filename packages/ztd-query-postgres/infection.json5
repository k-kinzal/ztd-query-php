// NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.
{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "timeout": 25,
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "build/infection/escaped.log",
        "summary": "build/infection/summary.log",
        "perMutator": "build/infection/per-mutator.md",
        "json": "build/infection/infection.json"
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 80,
    "minCoveredMsi": 80,
    "timeoutsAsEscaped": true,
    "maxTimeouts": 0,
    "tmpDir": "build/infection-tmp",
    "phpUnit": {
        "configDir": ".",
        "customPath": "vendor/bin/phpunit"
    },
    // Keep the toolkit's AI test reporter out of mutation runs because it replaces PHPUnit result output that Infection uses to distinguish killed mutants from escaped ones, and select the unit test suite here because Infection no longer accepts the deprecated testFrameworkOptions key.
    "testFrameworkExtraArgs": "--testsuite=unit --no-extensions"
}
