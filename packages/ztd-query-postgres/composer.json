{
    "name": "k-kinzal/ztd-query-postgres",
    "description": "PostgreSQL platform support for ZTD Query",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "k-kinzal/ztd-query-core": "@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92",
        "k-kinzal/sql-faker": "@dev",
        "nikic/php-fuzzer": "^0.0.11",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11 || ^12 || >=13.0 <13.3",
        "brianium/paratest": "^6.11 || ^7",
        "infection/infection": "^0.28 || ^0.29 || ^0.30 || ^0.31 || ^0.32 || ^0.34.1",
        "giorgiosironi/eris": "^1.0",
        "phpbench/phpbench": "^1.4",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "phpcompatibility/php-compatibility": "10.0.0-alpha2",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        },
        {
            "type": "path",
            "url": "../ztd-query-core"
        },
        {
            "type": "path",
            "url": "../sql-faker"
        }
    ],
    "autoload": {
        "psr-4": {
            "ZtdQuery\\Platform\\Postgres\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": [
                "tests/",
                "../ztd-query-core/tests/"
            ],
            "Fuzz\\": "fuzz/"
        }
    },
    "scripts": {
        "bench": "@bench:quick",
        "bench:quick": "phpbench run bench --bootstrap=vendor/autoload.php --report=aggregate --php-config='{\"memory_limit\":\"512M\"}' --warmup=1 --iterations=3 --revs=25",
        "bench:full": "phpbench run bench --bootstrap=vendor/autoload.php --report=aggregate --php-config='{\"memory_limit\":\"512M\"}' --warmup=2 --iterations=8 --revs=100",
        "test": "paratest --processes=auto --configuration=\"$(php bin/phpunit-configuration.php)\"",
        "test:unit": "@php -d memory_limit=512M vendor/bin/phpunit --configuration=\"$(php bin/phpunit-configuration.php)\" tests/Unit/",
        "test:fuzz": "phpunit fuzz/",
        "lint": [
            "@format:check",
            "@phpstan"
        ],
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz": [
            "@fuzz:robustness",
            "@fuzz:robustness:classify",
            "@fuzz:robustness:rewrite"
        ],
        "fuzz:robustness": "php-fuzzer fuzz fuzz/fuzz_robustness.php fuzz/corpus/robustness/",
        "fuzz:robustness:classify": "php-fuzzer fuzz fuzz/fuzz_robustness_classify.php fuzz/corpus/robustness-classify/",
        "fuzz:robustness:rewrite": "php-fuzzer fuzz fuzz/fuzz_robustness_rewrite.php fuzz/corpus/robustness-rewrite/",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "compat": "phpcs -q"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
