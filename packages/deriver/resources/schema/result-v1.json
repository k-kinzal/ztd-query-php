{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-kinzal.github.io/ztd-query-php/k-kinzal/deriver/schema/result-v1.json",
  "title": "Deriver result version 1",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshotId",
    "resultId",
    "query",
    "normalOutcomes",
    "exceptionalOutcomes",
    "reachability",
    "assessment",
    "frontiers",
    "projectDiagnostics",
    "assumptions",
    "evidence",
    "values",
    "statistics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "snapshotId": {
      "type": "string"
    },
    "resultId": {
      "type": "string"
    },
    "query": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "symbol",
            "scope",
            "budget"
          ],
          "properties": {
            "kind": {
              "const": "return"
            },
            "symbol": {
              "type": "string"
            },
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "budget": {
              "$ref": "#/$defs/budget"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "expression",
            "projection",
            "scope",
            "budget"
          ],
          "properties": {
            "kind": {
              "const": "value"
            },
            "expression": {
              "$ref": "#/$defs/expression"
            },
            "projection": {
              "$ref": "#/$defs/projection"
            },
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "budget": {
              "$ref": "#/$defs/budget"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "point",
            "variable",
            "projection",
            "scope",
            "budget"
          ],
          "properties": {
            "kind": {
              "const": "state"
            },
            "point": {
              "$ref": "#/$defs/point"
            },
            "variable": {
              "type": "string"
            },
            "projection": {
              "$ref": "#/$defs/projection"
            },
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "budget": {
              "$ref": "#/$defs/budget"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "point",
            "values",
            "scope",
            "budget"
          ],
          "properties": {
            "kind": {
              "const": "tuple"
            },
            "point": {
              "$ref": "#/$defs/point"
            },
            "values": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/expression"
              }
            },
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "budget": {
              "$ref": "#/$defs/budget"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "normalOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "guard",
          "values",
          "state",
          "evidence",
          "storage"
        ],
        "properties": {
          "guard": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/valueRef"
            }
          },
          "state": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/valueRef"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "storage": {
            "$ref": "#/$defs/storage"
          }
        },
        "additionalProperties": false
      }
    },
    "exceptionalOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "guard",
          "exception",
          "state",
          "storage",
          "evidence"
        ],
        "properties": {
          "guard": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "exception": {
            "$ref": "#/$defs/valueRef"
          },
          "state": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/valueRef"
            }
          },
          "storage": {
            "$ref": "#/$defs/storage"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "reachability": {
      "enum": [
        "may-reach",
        "unreachable"
      ]
    },
    "assessment": {
      "type": "object",
      "required": [
        "closure",
        "precision",
        "correlation",
        "coverage",
        "enumeration"
      ],
      "properties": {
        "closure": {
          "enum": [
            "closed",
            "open"
          ]
        },
        "precision": {
          "enum": [
            "exact-symbolic",
            "abstract",
            "opaque"
          ]
        },
        "correlation": {
          "enum": [
            "preserved",
            "relaxed"
          ]
        },
        "coverage": {
          "enum": [
            "over-approximation",
            "unavailable"
          ]
        },
        "enumeration": {
          "enum": [
            "finite-exhaustive",
            "not-enumerated",
            "truncated"
          ]
        }
      },
      "additionalProperties": false
    },
    "frontiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frontier"
      }
    },
    "projectDiagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frontier"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/derivation"
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "literal",
          "operands",
          "attributes",
          "redacted",
          "secret"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "literal": {
            "$ref": "#/$defs/scalar"
          },
          "operands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "$ref": "#/$defs/key"
                },
                "value": {
                  "$ref": "#/$defs/valueRef"
                }
              },
              "additionalProperties": false
            }
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "$ref": "#/$defs/scalar"
                }
              },
              "additionalProperties": false
            }
          },
          "redacted": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^v[0-9]+$"
      }
    },
    "statistics": {
      "type": "object",
      "required": [
        "transfers",
        "graphs",
        "cacheHits",
        "seconds",
        "peakMemoryBytes"
      ],
      "properties": {
        "transfers": {
          "type": "integer",
          "minimum": 0
        },
        "graphs": {
          "type": "integer",
          "minimum": 0
        },
        "cacheHits": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "peakMemoryBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scalar": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "bytes"
            },
            "value": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "int64"
            },
            "value": {
              "type": "string",
              "pattern": "^(?:0|-?[1-9][0-9]{0,18})$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "float64"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "null"
            },
            "value": {
              "type": "null"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "snapshotId",
        "path",
        "start",
        "end",
        "line",
        "column"
      ],
      "properties": {
        "snapshotId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "frontier": {
      "type": "object",
      "required": [
        "code",
        "at",
        "operation",
        "affectedProjections",
        "knownDependencies",
        "residual",
        "missingCapability"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/source"
        },
        "operation": {
          "type": "string"
        },
        "affectedProjections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knownDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "residual": {
          "anyOf": [
            {
              "$ref": "#/$defs/valueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "missingCapability": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "key": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/scalar"
            },
            {
              "properties": {
                "type": {
                  "const": "bytes"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/scalar"
            },
            {
              "properties": {
                "type": {
                  "const": "int64"
                }
              }
            }
          ]
        }
      ]
    },
    "valueRef": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "projection": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "slot": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "expression": {
      "type": "object",
      "required": [
        "source",
        "callable",
        "register"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "callable": {
          "type": "string"
        },
        "register": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": [
        "source",
        "callable",
        "instruction",
        "phase"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "callable": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "before",
            "after",
            "invocation"
          ]
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": [
        "transfers",
        "partitions",
        "iterations",
        "recursion",
        "nodes"
      ],
      "properties": {
        "transfers": {
          "type": "integer",
          "minimum": 1
        },
        "partitions": {
          "type": "integer",
          "minimum": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "recursion": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "symbol",
        "arguments",
        "receiver"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/key"
              },
              "value": {
                "$ref": "#/$defs/valueRef"
              }
            },
            "additionalProperties": false
          }
        },
        "receiver": {
          "anyOf": [
            {
              "$ref": "#/$defs/valueRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "entries"
          ],
          "properties": {
            "mode": {
              "const": "symbolic"
            },
            "entries": {
              "type": "array",
              "maxItems": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "entries"
          ],
          "properties": {
            "mode": {
              "const": "entrypoint"
            },
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/entry"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "derivation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "parents",
        "operation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "data",
            "effect",
            "call",
            "control",
            "argument",
            "return",
            "dispatch",
            "model",
            "widening",
            "frontier"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": [
        "bindings",
        "cells"
      ],
      "properties": {
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/valueRef"
          }
        },
        "cells": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/valueRef"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "description": "JSON record structure for schema version 1. Readers must also validate int64 bounds, canonical Base64, byte-tagged metadata, acyclic value references, evidence references, and source range ordering; these relations cannot be fully expressed by JSON Schema."
}
