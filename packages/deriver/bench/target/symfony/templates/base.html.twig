<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{% block title %}Harbor communities{% endblock %}</title><link rel="stylesheet" href="/style.css"></head><body><nav><a href="{{ path('home') }}">Harbor</a>{% if app.user %}<span>{{ app.user.displayName }}</span><form action="{{ path('logout') }}" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button>Sign out</button></form>{% else %}<a href="{{ path('login') }}">Sign in</a>{% endif %}</nav><main>{% block body %}{% endblock %}</main></body></html>
