{% extends 'base.html.twig' %}{% block body %}<h1>{{ board.name }}</h1>{% if is_granted('PUBLISH',board) %}<a href="{{ path('topic_new',{id:board.id}) }}">Start a discussion</a>{% endif %}{% for topic in topics %}<article><a href="{{ path('topic_show',{id:topic.id}) }}">{{ topic.title }}</a><p>{{ topic.author.displayName }} · {{ topic.state }}</p></article>{% endfor %}{% if topics|length == 30 %}<a href="?before={{ (topics|last).id }}">Older discussions</a>{% endif %}{% endblock %}
