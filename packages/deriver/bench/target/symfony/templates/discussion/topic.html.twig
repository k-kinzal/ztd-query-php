{% extends 'base.html.twig' %}{% block title %}{{ topic.title }} · Harbor{% endblock %}{% block body %}<h1>{{ topic.title }}</h1><p>{{ topic.state }}</p>{% for post in posts %}<article><strong>{{ post.author.displayName }}</strong><small>{{ post.createdAt|date('Y-m-d H:i','UTC') }} UTC</small><pre>{{ post.body }}</pre></article>{% endfor %}{% if posts|length == 50 %}<a href="?after={{ (posts|last).id }}">More replies</a>{% endif %}{% endblock %}
