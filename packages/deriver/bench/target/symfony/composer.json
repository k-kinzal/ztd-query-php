{
    "name": "bench/harbor-symfony",
    "description": "Harbor community platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "symfony/framework-bundle": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/form": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/serializer-pack": "^1.3",
        "symfony/security-csrf": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/workflow": "^8.1",
        "symfony/rate-limiter": "^8.1",
        "symfony/lock": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/scheduler": "^8.1",
        "symfony/monolog-bundle": "^4.0",
        "doctrine/orm": "^3.5",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.5",
        "twig/extra-bundle": "^3.20"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.1"
        }
    }
}
