includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        # Trusted extension callbacks are the boundary: failures become ModelContractException.
        broadCatchAllowedPaths:
            - src/Evaluation/Candidate/Invocation/Rules.php
            - src/Evaluation/Candidate/Models.php
        visibilityExemptNamespacePrefixes:
            - 'Tests'
    phpVersion: 80100
    level: max
    paths:
        - src
        - tests
