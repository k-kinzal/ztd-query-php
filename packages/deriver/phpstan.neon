includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        # Trusted extension callbacks are the boundary: failures become ModelContractException.
        broadCatchAllowedPaths:
            - src/Candidate/Invocation/Rules.php
            - src/Candidate/Models.php
        visibilityExemptNamespacePrefixes:
            - 'Tests'
        # The toolkit defaults plus Builder: a stage is named by what it analyses or produces, never by how it is assembled.
        forbiddenClassLikeNameSuffixes:
            - Helper
            - Helpers
            - Manager
            - Managers
            - Util
            - Utils
            - Utility
            - Utilities
            - Common
            - Shared
            - General
            - Misc
            - Miscellaneous
            - Stuff
            - Things
            - Thing
            - Object
            - Objects
            - Data
            - Info
            - Information
            - Detail
            - Details
            - Value
            - Values
            - Type
            - Types
            - Base
            - Abstract
            - Generic
            - Default
            - Standard
            - Simple
            - Basic
            - Custom
            - Special
            - Temp
            - Temporary
            - Wrapper
            - Wrappers
            - Service
            - Services
            - Engine
            - Engines
            - System
            - Systems
            - Evidence
            - Evidences
            - Outcome
            - Outcomes
            - Probe
            - Probes
            - Builder
            - Builders
    phpVersion: 80100
    level: max
    paths:
        - src
        - tests
