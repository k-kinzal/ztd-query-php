#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Install the deriver package dependencies with Composer first.\n");
    exit(2);
}
require $autoload;

exit((new Deriver\Command\Application())->run());
