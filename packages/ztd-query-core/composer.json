{
    "name": "k-kinzal/ztd-query-core",
    "description": "Zero Table Dependencies query layer for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.92",
        "phpunit/phpunit": "^10.5 || ^11 || ^12 || ^13",
        "infection/infection": "^0.28 || ^0.29 || ^0.30 || ^0.31 || ^0.32 || ^0.34.1",
        "brianium/paratest": "^6.11 || ^7",
        "k-kinzal/php-ai-toolkit": "dev-main"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "ZtdQuery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "paratest --processes=auto",
        "test:unit": "@php -d memory_limit=512M vendor/bin/phpunit tests/Unit/",
        "lint": [
            "@format:check",
            "@phpstan"
        ],
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "infection": "infection --threads=max --show-mutations --no-progress",
        "phpstan": "phpstan analyse src tests --memory-limit=512M"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
