# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        visibilityExemptNamespacePrefixes:
            - 'Tests'
            - 'Bench'
        forbiddenTermsByPath:
            'src/Schema/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/TypeMapper/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Hydrator/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Plan/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Fixture/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Platform/MySql/*': [postgres, pgsql, sqlite]
            'src/Platform/PostgreSql/*': [mysql, mariadb, sqlite]
            'src/Platform/Sqlite/*': [mysql, mariadb, postgres, pgsql]
        forbiddenNamespacePrefixes:
            - 'Tests\Fixture'
            - 'Tests\Fixtures'
    phpVersion: 80100
    level: max
    paths:
        - src
        - tests
        - fuzz
        - bench

    ignoreErrors:
        # Approved read-only ArrayAccess contract: offsetSet and offsetUnset reject writes.
        - identifier: customRules.noBrokenCodeExpectation
          message: '#^Delete this test case instead of expecting "LogicException" in expectException\(\):#'
          path: tests/Unit/Fixture/FixtureSetTest.php
          count: 2
