{
    "name": "k-kinzal/sql-fixture",
    "description": "Generate PHP-Faker based fixtures from SQL schemas",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "fakerphp/faker": "^1.23",
        "phpmyadmin/sql-parser": "^5.11"
    },
    "require-dev": {
        "brianium/paratest": "^6.11 || ^7",
        "friendsofphp/php-cs-fixer": "^3.92",
        "infection/infection": "^0.28 || ^0.29 || ^0.30 || ^0.31 || ^0.32 || ^0.34.1",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "k-kinzal/sql-faker": "@dev",
        "k-kinzal/testcontainers-php": "^0.5.1",
        "nikic/php-fuzzer": "^0.0.11",
        "phpcompatibility/php-compatibility": "10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11 || ^12 || ^13",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        },
        {
            "type": "path",
            "url": "../sql-faker"
        }
    ],
    "autoload": {
        "psr-4": {
            "SqlFixture\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Fuzz\\": "fuzz/"
        }
    },
    "scripts": {
        "test": "paratest --processes=auto --configuration=\"$(php bin/phpunit-configuration.php)\"",
        "test:parallel": "paratest --processes=auto --configuration=\"$(php bin/phpunit-configuration.php)\" --testsuite=unit",
        "test:unit": "@php -d memory_limit=512M vendor/bin/phpunit --configuration=\"$(php bin/phpunit-configuration.php)\" tests/Unit/",
        "test:integration": "phpunit --configuration=\"$(php bin/phpunit-configuration.php)\" tests/Integration/",
        "lint": [
            "@format:check",
            "@phpstan"
        ],
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz:create-table": "php-fuzzer fuzz fuzz/fuzz_create_table.php fuzz/corpus/create-table/",
        "fuzz:insert-select": "php-fuzzer fuzz fuzz/fuzz_insert_select.php fuzz/corpus/insert-select/",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "compat": "phpcs -q"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
