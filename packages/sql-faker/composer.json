{
    "name": "k-kinzal/sql-faker",
    "description": "Faker Provider for generating syntactically valid SQL statements",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "fakerphp/faker": "^1.23"
    },
    "require-dev": {
        "brianium/paratest": "^6.11 || ^7",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.95.24",
        "infection/infection": "^0.28 || ^0.29 || ^0.30 || ^0.31 || ^0.32 || ^0.34.1",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "k-kinzal/testcontainers-php": "^0.5.1",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "SqlFaker\\": "src/"
        },
        "files": [
            "src/MySql/StatementType.php",
            "src/PostgreSql/StatementType.php",
            "src/Sqlite/StatementType.php",
            "src/MySql/Grammar/Symbol.php",
            "src/MySql/Grammar/NonTerminal.php",
            "src/MySql/Grammar/Terminal.php",
            "src/MySql/Grammar/Production.php",
            "src/MySql/Grammar/ProductionRule.php",
            "src/MySql/Grammar/UnknownSymbolException.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Unit\\SqlFaker\\": "tests/Unit/",
            "Fuzz\\": "fuzz/"
        }
    },
    "scripts": {
        "build-mysql": "php bin/build-mysql.php",
        "build-pg": "php bin/build-pg.php",
        "build-sqlite": "php bin/build-sqlite.php",
        "bench": "@bench:quick",
        "bench:quick": "phpbench run bench --bootstrap=vendor/autoload.php --report=aggregate --php-config='{\"memory_limit\":\"512M\"}' --warmup=1 --iterations=3 --revs=25",
        "bench:full": "phpbench run bench --bootstrap=vendor/autoload.php --report=aggregate --php-config='{\"memory_limit\":\"512M\"}' --warmup=2 --iterations=8 --revs=100",
        "test": "paratest --testsuite unit --processes=auto",
        "test:unit": "phpunit --testsuite unit",
        "lint": [
            "@format:check",
            "@phpstan",
            "@deptrac",
            "@compat"
        ],
        "compat": "phpcs",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz": [
            "@fuzz:mysql",
            "@fuzz:pg",
            "@fuzz:sqlite"
        ],
        "fuzz:mysql": "php-fuzzer fuzz fuzz/fuzz_mysql_syntax.php fuzz/corpus/mysql/",
        "fuzz:pg": "php-fuzzer fuzz fuzz/fuzz_pg_syntax.php fuzz/corpus/pg/",
        "fuzz:sqlite": "php-fuzzer fuzz fuzz/fuzz_sqlite_syntax.php fuzz/corpus/sqlite/",
        "infection": "infection --threads=max --show-mutations --no-progress",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "deptrac": [
            "deptrac analyse --config-file=deptrac.yaml",
            "deptrac debug:unassigned --config-file=deptrac.yaml"
        ],
        "deptrac:debug": [
            "deptrac debug:unassigned --config-file=deptrac.yaml",
            "deptrac debug:unused --config-file=deptrac.yaml"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
