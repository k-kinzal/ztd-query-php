{
    "name": "k-kinzal/sql-faker",
    "description": "Faker Provider for generating syntactically valid SQL statements",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "fakerphp/faker": "^1.23"
    },
    "require-dev": {
        "brianium/paratest": "^7.3",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.95.25",
        "k-kinzal/container": "dev-main",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.4",
        "symfony/filesystem": "^6.4"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        },
        {
            "type": "path",
            "url": "../container",
            "options": {
                "versions": {
                    "k-kinzal/container": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "SqlFaker\\": "src/"
        },
        "files": [
            "src/MySql/StatementType.php",
            "src/PostgreSql/StatementType.php",
            "src/Sqlite/StatementType.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Fuzz\\": "fuzz/",
            "Bench\\": "bench/"
        }
    },
    "scripts": {
        "autoload:check": "composer dump-autoload --optimize --strict-psr --strict-ambiguous",
        "bench": "phpbench run --report=aggregate",
        "bench:full": "@bench",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
        "build-mysql": "php bin/build-mysql.php",
        "build-pg": "php bin/build-pg.php",
        "build-sqlite": "php bin/build-sqlite.php",
        "compat": "phpcs",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered --report-uncovered",
        "docgen": "docgen --packages=. --title=k-kinzal/sql-faker",
        "docgen:diff": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --diff=origin/main --serve"
        ],
        "docgen:fresh": "@docgen --no-cache",
        "docgen:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --serve"
        ],
        "doctest": "phpunit --testsuite doctest",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz": "@fuzz:smoke",
        "fuzz:mysql": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"is_dir('fuzz/corpus/mysql') || mkdir('fuzz/corpus/mysql', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_mysql_syntax.php fuzz/corpus/mysql/"
        ],
        "fuzz:pg": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"is_dir('fuzz/corpus/pg') || mkdir('fuzz/corpus/pg', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_pg_syntax.php fuzz/corpus/pg/"
        ],
        "fuzz:smoke": [
            "Composer\\Config::disableProcessTimeout",
            "@fuzz:mysql --max-runs=100",
            "@fuzz:pg --max-runs=100",
            "@fuzz:sqlite --max-runs=100"
        ],
        "fuzz:sqlite": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"is_dir('fuzz/corpus/sqlite') || mkdir('fuzz/corpus/sqlite', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_sqlite_syntax.php fuzz/corpus/sqlite/"
        ],
        "lint": [
            "@autoload:check",
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "loc-guard": "loc-guard --config=loc.yaml",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "paratest --processes=auto",
        "test:coverage": "@php -d memory_limit=1G vendor/bin/paratest --processes=auto --testsuite unit --coverage-xml build/coverage-xml --log-junit build/junit.xml",
        "test:unit": "phpunit --testsuite unit",
        "tree-guard": "tree-guard --config=tree.yaml"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/sql-faker",
        "docs": "https://k-kinzal.github.io/ztd-query-php/k-kinzal/sql-faker/"
    },
    "scripts-descriptions": {
        "fuzz": "Run every fuzz target with the bounded smoke budget.",
        "fuzz:smoke": "Run each fuzz target for up to 100 executions; individual fuzz:* commands run continuously."
    }
}
