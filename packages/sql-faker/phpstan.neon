# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        forbiddenTermsByPath:
            'src/Compiler/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Generation/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Grammar/*': [mysql, postgres, pgsql, sqlite, mariadb]
        forbiddenNamespacePrefixes:
            - 'Tests\Fixture'
            - 'Tests\Fixtures'
    level: max
    paths:
        - src
        - fuzz
        - tests
