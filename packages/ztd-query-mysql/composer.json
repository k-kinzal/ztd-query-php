{
    "name": "k-kinzal/ztd-query-mysql",
    "description": "MySQL platform support for ZTD Query",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "k-kinzal/ztd-query-core": "@dev",
        "phpmyadmin/sql-parser": "^5.11"
    },
    "require-dev": {
        "brianium/paratest": "^6.11 || ^7",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.95.24",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "k-kinzal/sql-faker": "@dev",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ztd-query-core"
        },
        {
            "type": "path",
            "url": "../sql-faker"
        },
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "ZtdQuery\\Platform\\MySql\\": "src/"
        },
        "files": [
            "src/Compatibility/ClassAliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Fuzz\\": "fuzz/",
            "Bench\\": "bench/"
        }
    },
    "scripts": {
        "bench": "phpbench run --report=aggregate",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
        "bench:full": "@bench",
        "test": "paratest --processes=auto",
        "test:unit": "phpunit --testsuite unit",
        "lint": [
            "@format:check",
            "@phpstan",
            "@loc-guard",
            "@tree-guard",
            "@deptrac",
            "@compat"
        ],
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz:robustness": [
            "@php -r \"is_dir('fuzz/corpus/robustness') || mkdir('fuzz/corpus/robustness', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_robustness.php fuzz/corpus/robustness/"
        ],
        "fuzz:robustness:classify": [
            "@php -r \"is_dir('fuzz/corpus/robustness-classify') || mkdir('fuzz/corpus/robustness-classify', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_robustness_classify.php fuzz/corpus/robustness-classify/"
        ],
        "fuzz:robustness:rewrite": [
            "@php -r \"is_dir('fuzz/corpus/robustness-rewrite') || mkdir('fuzz/corpus/robustness-rewrite', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_robustness_rewrite.php fuzz/corpus/robustness-rewrite/"
        ],
        "doctest": "phpunit --testsuite doctest",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "compat": "phpcs",
        "loc-guard": "loc-guard --config=loc.yaml",
        "tree-guard": "tree-guard --config=tree.yaml",
        "deptrac": [
            "deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered --report-uncovered",
            "deptrac debug:unassigned --config-file=deptrac.yaml"
        ],
        "deptrac:debug": [
            "deptrac debug:unassigned --config-file=deptrac.yaml",
            "deptrac debug:unused --config-file=deptrac.yaml"
        ],
        "docgen": "cd ../.. && packages/ztd-query-mysql/vendor/bin/docgen --packages=packages/ztd-query-mysql --exclude=packages/ztd-query-mysql/src/Compatibility/ClassAliases.php --deptrac=\"$PWD/packages/ztd-query-mysql/deptrac.yaml\" --output=packages/ztd-query-mysql/build/docs --cache-dir=packages/ztd-query-mysql/build/docgen-cache --title=k-kinzal/ztd-query-mysql --coverage=packages/ztd-query-mysql/build/coverage-xml",
        "docgen:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --serve"
        ],
        "docgen:diff": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --diff=origin/main --serve"
        ],
        "docgen:fresh": "@docgen --no-cache",
        "test:coverage": "phpunit --testsuite unit --coverage-xml build/coverage-xml --log-junit build/junit.xml"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/ztd-query-mysql"
    }
}
