#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloaders = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require_once $autoloader;
        break;
    }
}

use LemonParser\Parser;
use LemonParser\Preprocessor\Preprocessor;
use LemonParser\Printer\Printer;
use LemonParser\SyntaxException;

/**
 * Command line front door of lemon-parser.
 *
 * Usage:
 *   lemon-parser [-DNAME]... check FILE...        Read each file and report whether it is a grammar Lemon would accept
 *   lemon-parser [-DNAME]... stats FILE...        Count the declarations and rules of each file
 *   lemon-parser [-DNAME]... print FILE           Read a file and write it back out in the printer's layout
 *   lemon-parser [-DNAME]... preprocess FILE      Write the file after %ifdef regions are settled, as lemon -E does
 *
 * -DNAME defines a name for %ifdef, as Lemon's -D option does.
 */

/**
 * Reads a file or reports why it cannot be read.
 *
 * @param string $path Path of the grammar file
 *
 * @return string|null The contents, or null when the file cannot be read
 */
function readGrammar(string $path): ?string
{
    $contents = is_file($path) ? file_get_contents($path) : false;
    if ($contents === false) {
        fwrite(STDERR, "{$path}: cannot read the file\n");

        return null;
    }

    return $contents;
}

$defines = [];
$arguments = [];
foreach (array_slice($argv, 1) as $argument) {
    if (str_starts_with($argument, '-D')) {
        $defines[] = substr($argument, 2);
    } else {
        $arguments[] = $argument;
    }
}
$command = $arguments[0] ?? 'help';
$paths = array_slice($arguments, 1);
if (!in_array($command, ['check', 'stats', 'print', 'preprocess'], true) || $paths === []) {
    fwrite(STDERR, "Usage: lemon-parser [-DNAME]... check|stats|print|preprocess FILE...\n");
    exit(2);
}
$parser = new Parser();
$printer = new Printer();
$status = 0;
foreach ($paths as $path) {
    $source = readGrammar($path);
    if ($source === null) {
        $status = 1;
        continue;
    }
    try {
        if ($command === 'preprocess') {
            fwrite(STDOUT, (new Preprocessor())->preprocess($source, $defines));
            continue;
        }
        $file = $parser->parse($source, $defines);
    } catch (SyntaxException $exception) {
        fwrite(STDERR, "{$path}: {$exception->getMessage()}\n");
        $status = 1;
        continue;
    }
    if ($command === 'print') {
        fwrite(STDOUT, $printer->print($file));
        continue;
    }
    if ($command === 'stats') {
        fwrite(STDOUT, sprintf("%s: %d declarations, %d rules\n", $path, count($file->declarations()), count($file->rules())));
        continue;
    }
    $printed = $printer->print($file);
    $stable = $printer->print($parser->parse($printed)) === $printed;
    fwrite(STDOUT, "{$path}: " . ($stable ? 'ok' : 'read, but printing it is not stable') . "\n");
    $status = $stable ? $status : 1;
}
exit($status);
