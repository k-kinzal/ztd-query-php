{
    "name": "k-kinzal/lemon-parser",
    "description": "Parser for Lemon grammar files, producing a lossless syntax tree",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "behat/behat": "^3.14",
        "brianium/paratest": "^7.3",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.95.25",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "LemonParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Fuzz\\": "fuzz/",
            "Bench\\": "bench/",
            "Spec\\": "spec/"
        }
    },
    "scripts": {
        "autoload:check": "composer dump-autoload --optimize --strict-psr --strict-ambiguous",
        "bench": "phpbench run --report=aggregate",
        "bench:full": "@bench",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
        "compat": "phpcs",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered --report-uncovered",
        "docgen": "docgen --packages=. --title=k-kinzal/lemon-parser",
        "docgen:diff": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --diff=origin/main --serve"
        ],
        "docgen:fresh": "@docgen --no-cache",
        "docgen:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --serve"
        ],
        "doctest": "phpunit --testsuite doctest",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz": "@fuzz:smoke",
        "fuzz:parse": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"is_dir('fuzz/corpus/parse') || mkdir('fuzz/corpus/parse', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_parse.php fuzz/corpus/parse/"
        ],
        "fuzz:roundtrip": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"is_dir('fuzz/corpus/roundtrip') || mkdir('fuzz/corpus/roundtrip', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_roundtrip.php fuzz/corpus/roundtrip/"
        ],
        "fuzz:smoke": [
            "Composer\\Config::disableProcessTimeout",
            "@fuzz:parse --max-runs=100",
            "@fuzz:roundtrip --max-runs=100"
        ],
        "lint": [
            "@autoload:check",
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "loc-guard": "loc-guard --config=loc.yaml",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "spec": "behat --strict --no-interaction --no-snippets",
        "test": "paratest --processes=auto",
        "test:coverage": "@php -d memory_limit=1G vendor/bin/paratest --processes=auto --testsuite unit --coverage-xml build/coverage-xml --log-junit build/junit.xml",
        "test:unit": "phpunit --testsuite unit",
        "tree-guard": "tree-guard --config=tree.yaml"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/lemon-parser",
        "docs": "https://k-kinzal.github.io/ztd-query-php/k-kinzal/lemon-parser/"
    },
    "scripts-descriptions": {
        "fuzz": "Run every fuzz target with the bounded smoke budget.",
        "fuzz:smoke": "Run each fuzz target for up to 100 executions; individual fuzz:* commands run continuously.",
        "spec": "Run the Behat specification of the Lemon grammar-file language against the parser."
    },
    "bin": [
        "bin/lemon-parser"
    ]
}
