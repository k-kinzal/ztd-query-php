{
    "name": "k-kinzal/requirements",
    "description": "Specification verification and source traceability for PHP projects",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "league/commonmark": "^2.7",
        "opis/json-schema": "^2.6",
        "symfony/console": "^6.4",
        "symfony/css-selector": "^6.4",
        "symfony/dom-crawler": "^6.4",
        "symfony/http-client": "^6.4",
        "symfony/process": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "behat/behat": "^3.14",
        "friendsofphp/php-cs-fixer": "^3.95.25",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Requirements\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Requirements\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/requirements"
    ],
    "scripts": {
        "autoload:check": "composer dump-autoload --optimize --strict-psr --strict-ambiguous",
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "lint": [
            "@autoload:check",
            "@format:check",
            "@phpstan"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/requirements"
    }
}
