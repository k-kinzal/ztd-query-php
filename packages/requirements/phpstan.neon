# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        visibilityExemptNamespacePrefixes:
            - 'Tests'
        forbiddenNamespacePrefixes:
            - 'Tests\Fixture'
            - 'Tests\Fixtures'
        broadCatchAllowedPaths:
            # Reports every failure of a command as a JSON or console error with exit code 2.
            - '*/src/Console/Application.php'
            # Source extensions signal retrieval failures by throwing; the analysis reports each one.
            - '*/src/Report/Analyzer.php'
    phpVersion: 80100
    level: max
    paths:
        - src
        - tests
