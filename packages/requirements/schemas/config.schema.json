{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "const": 1
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "bootstrap": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "markdown": {
      "type": "object",
      "properties": {
        "experimental": {
          "const": true
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "experimental"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "runners": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "runners": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "extension": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "extension",
          "command"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "minimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "diff_minimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "definitions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/k-kinzal/ztd-query-php/main/packages/requirements/schemas/config.schema.json"
}
