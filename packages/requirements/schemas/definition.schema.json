{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "const": 1
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "required": [
    "version",
    "source",
    "items"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/k-kinzal/ztd-query-php/main/packages/requirements/schemas/definition.schema.json",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "snapshot": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "options": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "uri",
        "format",
        "selector"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "snapshot": [
          "sha256"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "selector",
        "quote"
      ],
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "run": {
          "enum": [
            "auto",
            "manual"
          ]
        }
      },
      "required": [
        "runner",
        "target"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "kind": {
          "enum": [
            "requirement",
            "specification"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "origin": {
          "enum": [
            "sourced",
            "original",
            "undocumented"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "design": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [],
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unsupported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "enum": [
                  "original",
                  "undocumented"
                ]
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "requirement"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "tests": {
                "maxItems": 0
              },
              "requirements": {
                "maxItems": 0
              },
              "status": {
                "const": "supported"
              }
            }
          }
        }
      ]
    }
  }
}
