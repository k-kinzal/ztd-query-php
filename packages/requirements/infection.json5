{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.4/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 80,
    "minCoveredMsi": 80,
    "timeout": 900,
    "timeoutsAsEscaped": false,
    "tmpDir": "build/infection-tmp",
    "logs": {
        "text": "build/infection/escaped.log",
        "summary": "build/infection/summary.log",
        "perMutator": "build/infection/per-mutator.md",
        "json": "build/infection/infection.json"
    },
    // Preserve PHPUnit result output for Infection by disabling the AI reporter.
    // Score all behavioral tests present in this package; documentation examples run separately.
    "testFrameworkExtraArgs": "--no-extensions --testsuite=unit",
    "testFramework": "phpunit",
    "phpUnit": {
        "configDir": ".",
        "customPath": "vendor/bin/phpunit"
    }
}
