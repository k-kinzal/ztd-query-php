includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        visibilityExemptNamespacePrefixes: ['Tests', 'Bench', 'Fuzz']
        forbiddenTermsByPath:
            'src/Core/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Platform/MySql/*': [postgres, pgsql, sqlite]
            'src/Platform/PostgreSql/*': [mysql, mariadb, sqlite]
            'src/Platform/Sqlite/*': [mysql, mariadb, postgres, pgsql]
        forbiddenNamespacePrefixes: ['Tests\Fixture', 'Tests\Fixtures']
    phpVersion: 80100
    level: max
    paths: [src, tests, fuzz, bench]
