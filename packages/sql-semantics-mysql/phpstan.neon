includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        visibilityExemptNamespacePrefixes: ['Tests', 'Bench']
        forbiddenNamespacePrefixes: ['Tests\\Fixture', 'Tests\\Fixtures']
    phpVersion: 80100
    level: max
    paths: [src, resources/models, tests, bench]
