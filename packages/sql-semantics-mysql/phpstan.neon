includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        visibilityExemptNamespacePrefixes: ['Tests', 'Bench']
        forbiddenNamespacePrefixes: ['Tests\\Fixture', 'Tests\\Fixtures']
    ignoreErrors:
        # The migrated model has its per-class unit suite in the SQLite package.
        -
            identifier: customRules.srcWithoutUnitTest
            path: src/Model/*
    phpVersion: 80100
    level: max
    paths: [src, tests, bench]
