# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        visibilityExemptNamespacePrefixes:
            - 'Tests'
            - 'Bench'
        forbiddenNamespacePrefixes:
            - 'Tests\Fixture'
            - 'Tests\Fixtures'
    phpVersion: 80100
    level: max
    stubFiles:
        - tests/Stub/MysqliFunctions.stub
    paths:
        - src
        - tests
        - fuzz
        - bench
    excludePaths:
        # PHPStan 2.2.14 still models bind_param() without reference parameters.
        - src/MysqliStatementBindingBridge.php
