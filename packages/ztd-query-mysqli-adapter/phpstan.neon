# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - fuzz
        - bench
        - phpstan
    excludePaths:
        # PHPStan 2.2.14 still models bind_param() without reference parameters.
        - src/MysqliStatementBindingBridge.php

services:
    -
        class: Quality\Mysqli\MysqliTypeExtension
        arguments:
            className: mysqli
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
            - phpstan.dynamicMethodThrowTypeExtension
    -
        class: Quality\Mysqli\MysqliTypeExtension
        arguments:
            className: mysqli_result
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
