# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    level: max
    paths:
        - src
        - fuzz
        - tests
    excludePaths:
        # PHPStan Bug: functionMap incorrectly defines mysqli_stmt::bind_param signature
        #
        # PHPStan's functionMap (resources/functionMap.php) has:
        #   'mysqli_stmt::bind_param' => ['bool', 'types'=>'string', 'var1'=>'mixed', '...args='=>'mixed']
        #
        # Missing '&' prefix means PHPStan thinks parameters are NOT by-reference.
        # PHP's actual signature requires by-reference:
        #   public function bind_param(string $types, mixed &...$vars): bool
        #
        # This causes an LSP violation error:
        #   "Parameter #2 $vars is passed by reference but parameter #2 $var1 of
        #    method mysqli_stmt::bind_param() is not passed by reference."
        #
        # This error is "ignorable: false" in PHPStan's design:
        #   - @phpstan-ignore comments do not work
        #   - ignoreErrors configuration does not work
        #   - baseline does not work
        #   - stubFiles cause "duplicate class" errors
        #
        # Correct functionMap entry should be:
        #   'mysqli_stmt::bind_param' => ['bool', 'types'=>'string', '&rw_var1'=>'mixed', '&...rw_vars='=>'mixed']
        #
        # Similar fix was applied to bind_result: https://github.com/phpstan/phpstan-src/commit/63ec225
        # Related issue: https://github.com/phpstan/phpstan/issues/2553
        #
        # TODO: Remove this excludePath once PHPStan fixes the functionMap for bind_param.
        - src/Driver/MysqliStatementBindingBridge.php
    ignoreErrors:
        # Same reason as ZtdMysqli::execute_query(): the stub extends mysqli, whose
        # execute_query() only exists from PHP 8.2, so the attribute the rule asks
        # for is a fatal error on the 8.1 this package still supports.
        -
            identifier: customRules.overrideMustHaveAttribute
            path: tests/Fixtures/StubMysqli.php
            reportUnmatched: false
        # mysqli::execute_query() arrived in PHP 8.2. This package supports 8.1,
        # where the parent method does not exist, so writing #[\Override] on the
        # override would be a fatal error at class-declaration time there. The
        # method has to stay: it is what keeps a one-shot query inside the shadow.
        -
            identifier: customRules.overrideMustHaveAttribute
            message: '#^Add \#\[\\Override\] to override method execute_query\(\)\.$#'
            path: src/ZtdMysqli.php
            reportUnmatched: false
        # mysqli_stmt and mysqli_result are built by the extension from a live
        # connection, and their constructors refuse to run without one. A test
        # double for either therefore cannot call the parent constructor; doing
        # what this rule asks would make every test that uses one fatal.
        -
            identifier: constructor.missingParentCall
            path: tests/Fixtures/StubMysqliStmt.php
            reportUnmatched: false
        -
            identifier: constructor.missingParentCall
            path: tests/Fixtures/StubMysqliResult.php
            reportUnmatched: false
