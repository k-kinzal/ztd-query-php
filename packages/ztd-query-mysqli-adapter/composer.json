{
    "name": "k-kinzal/ztd-query-mysqli-adapter",
    "description": "MySQLi adapter for ZTD Query",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-mysqli": "*",
        "k-kinzal/ztd-query-core": "dev-main",
        "k-kinzal/ztd-query-mysql": "dev-main"
    },
    "require-dev": {
        "brianium/paratest": "^7.3",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.95.25",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "k-kinzal/sql-faker": "dev-main",
        "k-kinzal/sql-fixture": "dev-main",
        "k-kinzal/testcontainers-php": "^0.5.1",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        },
        {
            "type": "path",
            "url": "../sql-faker",
            "options": {
                "versions": {
                    "k-kinzal/sql-faker": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../sql-fixture",
            "options": {
                "versions": {
                    "k-kinzal/sql-fixture": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../ztd-query-core",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-core": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../ztd-query-mysql",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-mysql": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "ZtdQuery\\Adapter\\Mysqli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Fuzz\\": "fuzz/",
            "Bench\\": "bench/"
        }
    },
    "scripts": {
        "bench": "phpbench run --report=aggregate",
        "bench:full": "@bench",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
        "compat": "phpcs",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered --report-uncovered",
        "docgen": "docgen --packages=. --title=k-kinzal/ztd-query-mysqli-adapter",
        "docgen:diff": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --diff=origin/main --serve"
        ],
        "docgen:fresh": "@docgen --no-cache",
        "docgen:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --serve"
        ],
        "doctest": "phpunit --testsuite doctest",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz": [
            "@fuzz:robustness",
            "@fuzz:correctness:select",
            "@fuzz:correctness:insert",
            "@fuzz:correctness:replace",
            "@fuzz:correctness:update",
            "@fuzz:correctness:delete"
        ],
        "fuzz:correctness:delete": [
            "@php -r \"is_dir('fuzz/corpus/correctness-delete') || mkdir('fuzz/corpus/correctness-delete', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_correctness_delete.php fuzz/corpus/correctness-delete/"
        ],
        "fuzz:correctness:insert": [
            "@php -r \"is_dir('fuzz/corpus/correctness-insert') || mkdir('fuzz/corpus/correctness-insert', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_correctness_insert.php fuzz/corpus/correctness-insert/"
        ],
        "fuzz:correctness:replace": [
            "@php -r \"is_dir('fuzz/corpus/correctness-replace') || mkdir('fuzz/corpus/correctness-replace', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_correctness_replace.php fuzz/corpus/correctness-replace/"
        ],
        "fuzz:correctness:select": [
            "@php -r \"is_dir('fuzz/corpus/correctness-select') || mkdir('fuzz/corpus/correctness-select', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_correctness_select.php fuzz/corpus/correctness-select/"
        ],
        "fuzz:correctness:update": [
            "@php -r \"is_dir('fuzz/corpus/correctness-update') || mkdir('fuzz/corpus/correctness-update', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_correctness_update.php fuzz/corpus/correctness-update/"
        ],
        "fuzz:robustness": [
            "@php -r \"is_dir('fuzz/corpus/robustness-execute') || mkdir('fuzz/corpus/robustness-execute', 0777, true);\" --",
            "php-fuzzer fuzz fuzz/fuzz_robustness_execute.php fuzz/corpus/robustness-execute/"
        ],
        "lint": [
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "loc-guard": "loc-guard --config=loc.yaml",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "paratest --processes=auto",
        "test:coverage": "@php -d memory_limit=1G vendor/bin/paratest --processes=auto --testsuite unit --coverage-xml build/coverage-xml --log-junit build/junit.xml",
        "test:integration": "phpunit --testsuite integration",
        "test:unit": "phpunit --testsuite unit",
        "tree-guard": "tree-guard --config=tree.yaml"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/ztd-query-mysqli-adapter",
        "docs": "https://k-kinzal.github.io/ztd-query-php/k-kinzal/ztd-query-mysqli-adapter/"
    }
}
