{
    "name": "k-kinzal/ztd-query-mysqli-adapter",
    "description": "MySQLi adapter for ZTD Query",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-mysqli": "*",
        "k-kinzal/ztd-query-core": "dev-main",
        "k-kinzal/ztd-query-mysql": "dev-main"
    },
    "require-dev": {
        "brianium/paratest": "^6.11 || ^7",
        "deptrac/deptrac": "^3.0 || ^4.7",
        "friendsofphp/php-cs-fixer": "^3.92",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "k-kinzal/sql-faker": "dev-main",
        "k-kinzal/sql-fixture": "dev-main",
        "k-kinzal/testcontainers-php": "^0.5.1",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11 || ^12 || ^13",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ztd-query-core",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-core": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../ztd-query-mysql",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-mysql": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../sql-faker",
            "options": {
                "versions": {
                    "k-kinzal/sql-faker": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../sql-fixture",
            "options": {
                "versions": {
                    "k-kinzal/sql-fixture": "dev-main"
                }
            }
        },
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "ZtdQuery\\Adapter\\Mysqli\\": [
                "src/",
                "src/Driver/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Fuzz\\": "fuzz/",
            "Bench\\": "bench/",
            "Tests\\Unit\\": [
                "tests/Unit/",
                "tests/Unit/Driver/"
            ],
            "Quality\\Mysqli\\": "phpstan/"
        }
    },
    "scripts": {
        "test": "@php -d memory_limit=512M tests/run.php --parallel --processes=auto --max-processes=4",
        "test:unit": "@php -d memory_limit=512M tests/run.php --testsuite unit",
        "test:integration": "@php -d memory_limit=512M tests/run.php --testsuite integration",
        "lint": [
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz": [
            "@fuzz:robustness",
            "@fuzz:correctness:select",
            "@fuzz:correctness:insert",
            "@fuzz:correctness:replace",
            "@fuzz:correctness:update",
            "@fuzz:correctness:delete"
        ],
        "fuzz:robustness": "php-fuzzer fuzz fuzz/fuzz_robustness_execute.php fuzz/corpus/robustness-execute --timeout=15",
        "fuzz:correctness:select": "php-fuzzer fuzz fuzz/fuzz_correctness_select.php fuzz/corpus/correctness-select --timeout=15",
        "fuzz:correctness:insert": "php-fuzzer fuzz fuzz/fuzz_correctness_insert.php fuzz/corpus/correctness-insert --timeout=15",
        "fuzz:correctness:replace": "php-fuzzer fuzz fuzz/fuzz_correctness_replace.php fuzz/corpus/correctness-replace --timeout=15",
        "fuzz:correctness:update": "php-fuzzer fuzz fuzz/fuzz_correctness_update.php fuzz/corpus/correctness-update --timeout=15",
        "fuzz:correctness:delete": "php-fuzzer fuzz fuzz/fuzz_correctness_delete.php fuzz/corpus/correctness-delete --timeout=15",
        "infection": "infection --configuration=infection.json5 --threads=4 --only-covering-test-cases --no-progress",
        "test:coverage": "@php -d memory_limit=1G tests/run.php --coverage-xml build/coverage-xml --log-junit build/junit.xml",
        "doctest": "@php -d memory_limit=512M tests/run.php --testsuite doctest",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "compat": "phpcs",
        "loc-guard": "loc-guard --config=loc.yaml",
        "tree-guard": "tree-guard --config=tree.yaml",
        "deptrac": [
            "deptrac analyse --config-file=deptrac.yaml",
            "deptrac debug:unassigned --config-file=deptrac.yaml"
        ],
        "deptrac:debug": [
            "deptrac debug:unassigned --config-file=deptrac.yaml",
            "deptrac debug:unused --config-file=deptrac.yaml"
        ],
        "bench": "phpbench run --report=aggregate --store",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10 --store",
        "bench:full": "@bench",
        "docgen": "cd ../.. && packages/ztd-query-mysqli-adapter/vendor/bin/docgen --packages=packages/ztd-query-mysqli-adapter --deptrac=\"$PWD/packages/ztd-query-mysqli-adapter/deptrac.yaml\" --output=packages/ztd-query-mysqli-adapter/build/docs --cache-dir=packages/ztd-query-mysqli-adapter/build/docgen-cache --title=k-kinzal/ztd-query-mysqli-adapter --coverage=packages/ztd-query-mysqli-adapter/build/coverage-xml",
        "docgen:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --serve"
        ],
        "docgen:diff": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --diff=origin/main --serve"
        ],
        "docgen:fresh": "@docgen --no-cache"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/ztd-query-mysqli-adapter"
    }
}
