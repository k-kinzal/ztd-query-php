{
    "name": "k-kinzal/ztd-query-mysqli-adapter",
    "description": "MySQLi adapter for ZTD Query",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-mysqli": "*",
        "k-kinzal/ztd-query-core": "dev-main",
        "k-kinzal/ztd-query-mysql": "dev-main"
    },
    "require-dev": {
        "brianium/paratest": "^7",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.95.24",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "k-kinzal/sql-faker": "dev-main",
        "k-kinzal/sql-fixture": "dev-main",
        "k-kinzal/testcontainers-php": "^0.5.1",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ztd-query-core",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-core": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../ztd-query-mysql",
            "options": {
                "versions": {
                    "k-kinzal/ztd-query-mysql": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../sql-faker",
            "options": {
                "versions": {
                    "k-kinzal/sql-faker": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../sql-fixture",
            "options": {
                "versions": {
                    "k-kinzal/sql-fixture": "dev-main"
                }
            }
        },
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "ZtdQuery\\Adapter\\Mysqli\\": [
                "src/",
                "src/Driver/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Fuzz\\": "fuzz/",
            "Bench\\": "bench/",
            "Tests\\Unit\\": [
                "tests/Unit/",
                "tests/Unit/Driver/"
            ],
            "Containers\\": "containers/"
        }
    },
    "scripts": {
        "test": "paratest --processes=4",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "lint": [
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz": [
            "@fuzz:robustness",
            "@fuzz:correctness:select",
            "@fuzz:correctness:insert",
            "@fuzz:correctness:replace",
            "@fuzz:correctness:update",
            "@fuzz:correctness:delete"
        ],
        "fuzz:robustness": [
            "Composer\\Config::disableProcessTimeout",
            "php-fuzzer fuzz fuzz/fuzz_robustness_execute.php fuzz/corpus/robustness-execute --timeout=15"
        ],
        "fuzz:correctness:select": [
            "Composer\\Config::disableProcessTimeout",
            "php-fuzzer fuzz fuzz/fuzz_correctness_select.php fuzz/corpus/correctness-select --timeout=15"
        ],
        "fuzz:correctness:insert": [
            "Composer\\Config::disableProcessTimeout",
            "php-fuzzer fuzz fuzz/fuzz_correctness_insert.php fuzz/corpus/correctness-insert --timeout=15"
        ],
        "fuzz:correctness:replace": [
            "Composer\\Config::disableProcessTimeout",
            "php-fuzzer fuzz fuzz/fuzz_correctness_replace.php fuzz/corpus/correctness-replace --timeout=15"
        ],
        "fuzz:correctness:update": [
            "Composer\\Config::disableProcessTimeout",
            "php-fuzzer fuzz fuzz/fuzz_correctness_update.php fuzz/corpus/correctness-update --timeout=15"
        ],
        "fuzz:correctness:delete": [
            "Composer\\Config::disableProcessTimeout",
            "php-fuzzer fuzz fuzz/fuzz_correctness_delete.php fuzz/corpus/correctness-delete --timeout=15"
        ],
        "test:coverage": "phpunit --coverage-xml build/coverage-xml --log-junit build/junit.xml",
        "doctest": "phpunit --testsuite doctest",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "compat": "phpcs",
        "loc-guard": "loc-guard --config=loc.yaml",
        "tree-guard": "tree-guard --config=tree.yaml",
        "deptrac": [
            "deptrac analyse --config-file=deptrac.yaml",
            "deptrac debug:unassigned --config-file=deptrac.yaml"
        ],
        "deptrac:debug": [
            "deptrac debug:unassigned --config-file=deptrac.yaml",
            "deptrac debug:unused --config-file=deptrac.yaml"
        ],
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "phpbench run --report=timing --store"
        ],
        "bench:quick": [
            "Composer\\Config::disableProcessTimeout",
            "phpbench run --report=timing --warmup=1 --iterations=3 --retry-threshold=10 --store"
        ],
        "bench:full": "@bench",
        "docgen": "cd ../.. && packages/ztd-query-mysqli-adapter/vendor/bin/docgen --packages=packages/ztd-query-mysqli-adapter --deptrac=\"$PWD/packages/ztd-query-mysqli-adapter/deptrac.yaml\" --output=packages/ztd-query-mysqli-adapter/build/docs --cache-dir=packages/ztd-query-mysqli-adapter/build/docgen-cache --title=k-kinzal/ztd-query-mysqli-adapter --coverage=packages/ztd-query-mysqli-adapter/build/coverage-xml",
        "docgen:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --serve"
        ],
        "docgen:diff": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --diff=origin/main --serve"
        ],
        "docgen:fresh": "@docgen --no-cache"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/ztd-query-mysqli-adapter",
        "docs": "https://k-kinzal.github.io/ztd-query-php/mysqli/k-kinzal/ztd-query-mysqli-adapter/"
    }
}
