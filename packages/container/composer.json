{
    "name": "k-kinzal/container",
    "description": "Shared database containers for integration and fuzz testing",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "k-kinzal/testcontainers-php": "^0.5.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11 || ^12 || ^13"
    },
    "suggest": {
        "ext-mysqli": "Required for MySQLi integration containers",
        "ext-pdo_mysql": "Required for MySQL containers",
        "ext-pdo_pgsql": "Required for PostgreSQL containers"
    },
    "autoload": {
        "psr-4": {
            "Container\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "lint": [
            "@format:check",
            "phpstan analyse --memory-limit=512M"
        ],
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes"
    },
    "config": {
        "sort-packages": true
    }
}
