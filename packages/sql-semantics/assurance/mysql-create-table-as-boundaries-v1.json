{
  "revision": "SemanticsIR/mysql-create-table-as-boundaries-1",
  "approval": "pending-human-review",
  "base": {
    "path": "native-boundaries-v31.json",
    "sha256": "3fca83f52f260bf9f43b909228eeed7f00d77534d2183368b530673364738b55"
  },
  "scope": "Close the checked query, projection roles, target lowering and SQL assembly at the native CTAS boundary. Model the one-row MySQL 5.6 source used for source-free ordering.",
  "rules": {
    "Schema/Query/CreateTableAs::__construct": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "Check::input($query->source === null, 'CREATE TABLE AS requires a source-free projection.');",
        "Check::input(count($query->columns) <= 128, 'CREATE TABLE AS can have at most 128 columns.');",
        "Check::input(",
        "    $query->where === null || $query->where instanceof BooleanLiteral || $query->where instanceof NullLiteral,",
        "    'CREATE TABLE AS requires a constant boolean or NULL filter.'",
        ");",
        "",
        "$seen = [];",
        "foreach ($query->columns as $column) {",
        "    Check::input(",
        "        preg_match('/\\A[\\x01-\\x7f]{1,64}(?<! )\\z/D', $column->name->value) === 1,",
        "        'CREATE TABLE AS requires ASCII column names of 1 to 64 characters without trailing spaces.'",
        "    );",
        "    $key = $column->name->key();",
        "    Check::input(!isset($seen[$key]), 'CREATE TABLE AS cannot repeat a column name.');",
        "    $seen[$key] = true;",
        "",
        "    $expression = $column->expression;",
        "    $term = $expression instanceof SignedCast ? $expression->operand : $expression;",
        "    Check::input(",
        "        $term instanceof BooleanLiteral || $term instanceof NullLiteral",
        "            || ($term instanceof IntegerLiteral && $term->leadingZeroes === 0 && !$term->negativeZero),",
        "        'CREATE TABLE AS requires unpadded integral or NULL literals and their single signed casts.'",
        "    );",
        "}"
      ]
    },
    "Schema/Query/CreateTableAs::profileId": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "return $this->query->release->value . '/utf8mb4/lower-case-table-names=0/sql-mode=empty/native/innodb';"
      ]
    },
    "Schema/Query/CreateTableAs::toString": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "return 'CREATE ' . ($this->target->kind === ExternalRelationKind::TemporaryTable ? 'TEMPORARY ' : '')",
        "    . 'TABLE ' . ($this->ifNotExists ? 'IF NOT EXISTS ' : '') . $this->target->quoted()",
        "    . ' ENGINE=InnoDB AS ' . $this->query->toString();"
      ]
    },
    "Schema/Query/CreateTableAsLowering::lower": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "$query = $statement->query;",
        "Check::input(",
        "    $query !== null && $query->query instanceof ParsedSelect && $query->duplicate === null",
        "        && $statement->elements === [] && $statement->partitioning === null && !$statement->enclosed,",
        "    'CREATE TABLE AS requires a single projection without explicit table definitions or a duplicate policy.'",
        ");",
        "",
        "$options = $statement->options;",
        "$engine = $options[0] ?? null;",
        "Check::input(",
        "    $options === [] || (count($options) === 1 && $engine instanceof EngineOption && strcasecmp($engine->engine->value, 'InnoDB') === 0),",
        "    'CREATE TABLE AS requires the native InnoDB storage role.'",
        ");",
        "$context = $operation->context;",
        "Check::input($context->relationNames === Comparison::Sensitive, 'CREATE TABLE AS requires exact relation names.');",
        "$schema = ($statement->name->schema ?? $context->declarationSchema)->value;",
        "Check::input($schema !== SessionDatabase::UNNAMED, 'CREATE TABLE AS requires an absolute target name.');",
        "$table = new TableName(new Identifier($schema), new Identifier($statement->name->name->value));",
        "$kind = $statement->temporary() ? ExternalRelationKind::TemporaryTable : ExternalRelationKind::BaseTable;",
        "",
        "return new CreateTableAs(",
        "    new TableIdentity($table, $kind),",
        "    (new SelectLowering())->lower($operation, $query->query),",
        "    $statement->ifNotExists",
        ");"
      ]
    },
    "SelectSql::render": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "$source = $select->source;",
        "$items = [];",
        "foreach ($select->columns as $slot => $column) {",
        "    $name = $localNames ? $this->localColumn($slot) : $column->name->quoted();",
        "    $label = $column->name->value;",
        "    $alias = $localNames || $label === ltrim($label, \" \\t\\r\\n\\v\\f\") ? ' AS ' . $name : '';",
        "    $items[] = $this->expression($column->expression, $source) . $alias;",
        "}",
        "$sql = ($select->distinct ? 'SELECT DISTINCT ' : 'SELECT ') . implode(', ', $items);",
        "if ($source !== null) {",
        "    $sql .= ' FROM ' . $this->from($source);",
        "} elseif ($select->release === GrammarRelease::MySql5651 && $select->orderBy !== []) {",
        "    $sql .= ' FROM (SELECT 1 AS `__ztd_unit`) AS `__ztd_single`';",
        "} elseif (($select->release === GrammarRelease::MySql5651 || $select->release === GrammarRelease::MySql5744)",
        "    && ($select->where !== null || $select->orderBy !== [] || $select->limit !== null)) {",
        "    $sql .= ' FROM DUAL';",
        "}",
        "if ($select->where !== null) {",
        "    $sql .= ' WHERE ' . $this->predicate($select->where, $source);",
        "}",
        "",
        "return $sql . (new ResultSql())->render($select);"
      ]
    }
  }
}
