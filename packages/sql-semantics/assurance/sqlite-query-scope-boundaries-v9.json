{
  "revision": "SemanticsIR/sqlite-query-scope-boundaries-9",
  "rules": {
    "From/SelectBounds::check": {
      "common": [
        "Check::input(count($results) <= 2000, 'A SELECT can have at most 2000 result columns in this profile.');",
        "Check::input(count($joins) < 64 && ($joins === [] || $source !== null), 'Joins require a first table and at most 64 inputs.');",
        "$local = (new LocalInputs())->checked($source, $joins);",
        "Check::input(count($orderBy) <= 2000, 'A SELECT can have at most 2000 ordering terms in this profile.');",
        "foreach ($orderBy as $order) {",
        "    Check::input($order->position <= count($results), 'An output order position must belong to the projection.');",
        "}",
        "",
        "$widths = [$source === null ? 0 : count($source->columns)];",
        "$pending = [];",
        "if ($local !== null && $local->query instanceof RecursiveDefinition) {",
        "    $pending = $local->query->scopedExpressions();",
        "} elseif ($local !== null) {",
        "    foreach ($local->query->rows as $row) {",
        "        foreach ($row->values as $value) {",
        "            $pending[] = [$value, 0, 0];",
        "        }",
        "    }",
        "}",
        "foreach ($joins as $join) {",
        "    $widths[] = count($join->source->columns);",
        "    if ($join->on !== null) {",
        "        $pending[] = [$join->on, 0, count($widths)];",
        "    }",
        "}",
        "foreach ($results as $result) {",
        "    $pending[] = [$result->expression, 0, count($widths)];",
        "}",
        "foreach ([$where, $limit?->count, $limit?->offset] as $operand) {",
        "    if ($operand !== null) {",
        "        $pending[] = [$operand, 0, count($widths)];",
        "    }",
        "}",
        "",
        "(new ExpressionScope())->check($widths, $pending, $allowParameters, $allowParameters);"
      ]
    },
    "Select::__construct": {
      "common": [
        "$results = Check::listOf($columns, ResultColumn::class, 'A SELECT needs a nonempty list of result columns.', 1);",
        "$this->joins = Check::listOf($joins, Join::class, 'Joins must be an ordered list of join steps.');",
        "$this->orderBy = Check::listOf($orderBy, Order::class, 'Ordering must be an ordered list of output positions.');",
        "(new SelectBounds())->check($results, $source, $this->joins, $where, $this->orderBy, $limit);",
        "$this->columns = $results;"
      ]
    },
    "From/QueryClauses::joins": {
      "common": [
        "if (!$source instanceof JoinChain) {",
        "    return [];",
        "}",
        "$predicates = [];",
        "foreach ($source->steps as $position => $step) {",
        "    $predicates[] = match (true) {",
        "        $step->operator->natural(), $step->constraint instanceof JoinUsing",
        "            => (new JoinKeyLowering())->predicate($source, $step, $binding, $operation, $position),",
        "        $step->constraint instanceof JoinOn => $this->predicate($step->constraint->condition, $binding),",
        "        $step->constraint === null => null,",
        "    };",
        "}",
        "$joins = [];",
        "foreach ($source->steps as $index => $step) {",
        "    $right = $binding->input($index + 1);",
        "    Check::invariant($right instanceof TableSource || $right instanceof LocalSource, 'Every join step has a bound input occurrence.');",
        "    $joins[] = new Join($this->kind($step->operator), $right, $predicates[$index]);",
        "}",
        "",
        "return $joins;"
      ]
    },
    "From/SourceDeclarations::bind": {
      "common": [
        "if ($source === null) {",
        "    Check::input($localDefinition === null, 'A WITH SELECT must read its checked local definition.');",
        "",
        "    return [];",
        "}",
        "$comparison = NameComparison::AsciiInsensitive;",
        "$path = $operation->context->searchPath;",
        "Check::input(",
        "    $operation->context->relationNames === $comparison",
        "        && $operation->context->columnNames === $comparison,",
        "    'The declaration context must use SQLite name comparison.',",
        ");",
        "Check::input(",
        "    isset($path[1]) && $comparison->equal($path[0]->value, 'temp') && $comparison->equal($path[1]->value, 'main'),",
        "    'The declaration context must search temp and main before attached schemas.',",
        ");",
        "$terms = [$source];",
        "if ($source instanceof JoinChain) {",
        "    Check::input($source->constraint === null, 'The first table cannot have a join constraint.');",
        "    $terms = [$source->first];",
        "    foreach ($source->steps as $step) {",
        "        $terms[] = $step->relation;",
        "    }",
        "}",
        "$tables = [];",
        "$usesLocal = false;",
        "foreach ($terms as $term) {",
        "    Check::input(($term instanceof TableInput || $term instanceof MutationTarget) && $term->index === null, 'The projection source must be an ordinary table input.');",
        "    $resolution = $operation->facts->relation($term)->table;",
        "    if ($resolution instanceof CommonTable && $localDefinition !== null && $resolution->definition === $localDefinition[0]) {",
        "        $tables[] = [$term, $localDefinition[1]];",
        "        $usesLocal = true;",
        "        continue;",
        "    }",
        "    $kinds = $term instanceof TableInput ? [RelationKind::BaseTable, RelationKind::View] : [RelationKind::BaseTable];",
        "    Check::input(",
        "        $resolution instanceof DeclaredTable && $resolution->table->complete",
        "            && in_array($resolution->table->kind, $kinds, true) && $resolution->table->name->catalog === null,",
        "        'Reading requires a resolved, complete table or view declaration. A mutation target requires a base table.',",
        "    );",
        "    $tables[] = [$term, $resolution->table];",
        "}",
        "",
        "Check::input($localDefinition === null || $usesLocal, 'A WITH SELECT must read its checked local definition.');",
        "",
        "return $tables;"
      ]
    },
    "Rows/LocalSourceLowering::lower": {
      "common": [
        "Check::input(count($statement->with->tables) === 1, 'A complete local source requires one definition.');",
        "$definition = $statement->with->tables[0];",
        "Check::input(",
        "    ($definition->query instanceof ValuesClause || $definition->query instanceof Compound)",
        "        && $definition->columns !== [] && $definition->materialization === null,",
        "    'The local source requires an explicit column list and a supported definition without a materialization hint.',",
        ");",
        "$columns = [];",
        "foreach ($definition->columns as $column) {",
        "    $columns[] = new Identifier($column->name->value);",
        "}",
        "",
        "$query = $definition->query instanceof Compound",
        "    ? (new RecursiveLowering())->lower($operation, $definition, $definition->query, $columns)",
        "    : (new ValuesLowering())->lower($operation, $definition->query);",
        "",
        "return new LocalSource($query, $columns);"
      ]
    },
    "Rows/LocalInputs::occurrences": {
      "common": [
        "$local = $source instanceof LocalSource ? [$source] : [];",
        "foreach ($joins as $join) {",
        "    if ($join->source instanceof LocalSource) {",
        "        $local[] = $join->source;",
        "    }",
        "}",
        "",
        "return $local;"
      ]
    },
    "Rows/LocalInputs::checked": {
      "common": [
        "$uses = $this->occurrences($source, $joins);",
        "$local = $uses[0] ?? null;",
        "foreach ($uses as $use) {",
        "    Check::input($use === $local, 'A joined SELECT must share one local definition.');",
        "}",
        "Check::input(!($local?->query instanceof RecursiveDefinition) || $joins === [], 'A recursive local definition requires a SELECT without joins.');",
        "",
        "return $local;"
      ]
    },
    "Rows/CompoundBounds::check": {
      "common": [
        "Check::input(count($steps) < 500, 'A compound can have at most 500 arms.');",
        "$width = null;",
        "$bytes = $prefixBytes;",
        "$arms = [$first];",
        "foreach ($steps as $step) {",
        "    $arms[] = $step->query;",
        "    $bytes += 2 + strlen($step->operator->value);",
        "}",
        "foreach ($arms as $arm) {",
        "    if ($arm instanceof Select) {",
        "        Check::input((new LocalInputs())->occurrences($arm->source, $arm->joins) === [], 'A compound arm cannot contain WITH.');",
        "        Check::input($arm->orderBy === [] && $arm->limit === null, 'Compound ORDER BY and LIMIT belong to the outer query.');",
        "    }",
        "    $armWidth = $arm instanceof Select ? count($arm->columns) : count($arm->rows[0]->values);",
        "    $width ??= $armWidth;",
        "    Check::input($armWidth === $width, 'Compound arms must have the same width.');",
        "    $bytes += strlen($arm->toString());",
        "    Check::input($bytes <= self::MAX_SQL_BYTES, 'Compound exceeds the SQLite statement size budget.');",
        "}",
        "$last = $steps[count($steps) - 1]->query;",
        "Check::input($last instanceof Select || ($orderBy === [] && $limit === null), 'Compound ORDER BY or LIMIT requires a final SELECT arm.');",
        "Check::input(count($orderBy) <= 2000, 'A compound can have at most 2000 ordering terms.');",
        "foreach ($orderBy as $order) {",
        "    Check::input($order->position <= $width, 'Compound order position must belong to the output.');",
        "}",
        "",
        "$renderer = new SelectSql();",
        "$bytes += strlen($renderer->ordering($orderBy));",
        "if ($limit !== null) {",
        "    $operands = [[$limit->count, 0, 0]];",
        "    if ($limit->offset !== null) {",
        "        $operands[] = [$limit->offset, 0, 0];",
        "    }",
        "    (new ExpressionScope())->check([], $operands);",
        "    $bytes += 1 + strlen($renderer->limit($limit));",
        "}",
        "Check::input($bytes <= self::MAX_SQL_BYTES, 'Compound exceeds the SQLite statement size budget.');"
      ]
    },
    "SelectLowering::lower": {
      "common": [
        "$statement = $arm ?? $operation->statement;",
        "$local = null;",
        "if ($statement instanceof WithQuery) {",
        "    $definition = (new LocalSourceLowering())->lower($operation, $statement);",
        "    $local = [$statement->with->tables[0], $definition];",
        "    $statement = $statement->body;",
        "}",
        "Check::input($statement instanceof ParsedSelect, 'Complete SQLite IR currently supports a single projection SELECT.');",
        "Check::input(",
        "    $statement->groupBy === [] && $statement->having === null && $statement->windows === [],",
        "    'Complete SQLite IR currently supports projections without grouping or windows.',",
        ");",
        "$binding = new SourceBinding($operation, $statement->from, localDefinition: $local);",
        "$expressions = new ExpressionLowering();",
        "$fields = $arm === null ? $operation->facts->output?->fields() : $operation->facts->query($arm)->fields();",
        "Check::input($fields !== null, 'A complete projection requires a resolved output shape.');",
        "$results = [];",
        "foreach ($fields as $field) {",
        "    $name = $field->name;",
        "    Check::input($name !== null, 'The result must have a resolved name.');",
        "    $label = new Identifier($name->value);",
        "    $expression = $field->expression;",
        "    if ($expression === null) {",
        "        $resolution = $field->resolution;",
        "        Check::input($resolution instanceof ResolvedColumn, 'A wildcard field must resolve to a visible input value.');",
        "        $results[] = new ResultColumn($binding->value($resolution), $label);",
        "        continue;",
        "    }",
        "    $results[] = new ResultColumn($expressions->lower($expression, $binding), $label);",
        "}",
        "",
        "Check::input($results !== [], 'A complete projection requires at least one resolved output field.');",
        "",
        "$clauses = new QueryClauses();",
        "$where = $clauses->predicate($statement->where, $binding);",
        "$joins = $clauses->joins($statement->from, $binding, $operation);",
        "",
        "return new Select(",
        "    $results,",
        "    $binding->input(),",
        "    $joins,",
        "    $where,",
        "    $clauses->ordering($statement->orderBy),",
        "    $statement->quantifier === SetQuantifier::Distinct,",
        "    $clauses->limit($statement->limit, $binding),",
        ");"
      ]
    },
    "TableSource::__construct": {
      "common": [
        "$names = Check::listOf($columns, Identifier::class, 'A table source needs an ordered list of identifier slots.');",
        "$seen = [];",
        "foreach ($names as $name) {",
        "    $key = $name->key();",
        "    Check::input(!isset($seen[$key]), 'A table source cannot repeat a column name.');",
        "    $seen[$key] = true;",
        "}",
        "$this->columns = $names;"
      ]
    },
    "From/QueryClauses::kind": {
      "common": [
        "Check::input($operator->valid(), 'The IR requires a valid SQLite join operator.');",
        "$left = $operator->left();",
        "$right = $operator->right();",
        "",
        "return match (true) {",
        "    $left && $right => JoinKind::Full,",
        "    $left => JoinKind::Left,",
        "    $right => JoinKind::Right,",
        "    in_array(JoinKeyword::Cross, $operator->words, true) => JoinKind::Cross,",
        "    $operator->words === [], $operator->natural(), in_array(JoinKeyword::Inner, $operator->words, true) => JoinKind::Inner,",
        "    default => throw new InvalidConstruction('The join operator has no complete IR representation.'),",
        "};"
      ]
    },
    "From/JoinKeyLowering::predicate": {
      "common": [
        "Check::input(",
        "    count($chain->steps) === 1 || array_filter($chain->steps, static fn (JoinStep $item): bool => $item->operator->right()) === [],",
        "    'A merged prefix requires INNER, CROSS, or LEFT steps.',",
        ");",
        "$declarations = new SourceDeclarations();",
        "$left = $declarations->prefixHeading($operation, $chain, $position);",
        "$right = $declarations->mergeHeading($operation, $step->relation);",
        "$keys = $step->constraint instanceof JoinUsing",
        "    ? array_map(static fn (Name $name): string => NameComparison::AsciiInsensitive->fold($name->value), $step->constraint->columns)",
        "    : array_keys(array_intersect_key($right, $left));",
        "$predicate = null;",
        "foreach ($keys as $key) {",
        "    Check::input(isset($left[$key], $right[$key]), 'A USING key must identify one declared column on each side.');",
        "    [$occurrence, $column] = $left[$key];",
        "    $rightOccurrence = $position + 1;",
        "    $equality = new Comparison(",
        "        ComparisonOperator::Equal,",
        "        new ColumnReference($binding->slot($occurrence, $column), $occurrence),",
        "        new ColumnReference($binding->slot($rightOccurrence, $right[$key]), $rightOccurrence),",
        "    );",
        "    $predicate = $predicate === null ? $equality : new Logical(LogicalOperator::And, $predicate, $equality);",
        "}",
        "",
        "return $predicate;"
      ]
    },
    "From/SourceDeclarations::mergeHeading": {
      "common": [
        "$resolution = $operation->facts->relation($source)->table;",
        "Check::input($resolution instanceof DeclaredTable && $resolution->table->complete && $resolution->table->kind === RelationKind::BaseTable, 'A merged join requires complete base-table headings.');",
        "$columns = [];",
        "foreach ($resolution->table->columns as $column) {",
        "    $key = NameComparison::AsciiInsensitive->fold($column->name->value);",
        "    Check::input(!isset($columns[$key]), 'A merged join requires distinct names in each heading.');",
        "    $columns[$key] = $column;",
        "}",
        "",
        "return $columns;"
      ]
    },
    "SourceBinding::value": {
      "common": [
        "$merge = $resolution->merge;",
        "if ($merge === null) {",
        "    return $this->resolved($resolution);",
        "}",
        "Check::input($resolution->depth === 0, 'A merged column must belong to the local query.');",
        "",
        "return new Coalesce([",
        "    new CoalesceArgument($this->value($merge->left)),",
        "    new CoalesceArgument($this->value($merge->right)),",
        "]);"
      ]
    },
    "SourceBinding::reference": {
      "common": [
        "$resolution = $this->operation->facts->scalar($expression)->resolution;",
        "Check::input($resolution instanceof ResolvedColumn, 'The column must resolve to the projection source.');",
        "",
        "return $this->resolved($resolution);"
      ]
    },
    "SourceBinding::scalarValue": {
      "common": [
        "$resolution = $this->operation->facts->scalar($expression)->resolution;",
        "Check::input($resolution instanceof ResolvedColumn, 'The column must resolve to the projection source.');",
        "",
        "return $this->value($resolution);"
      ]
    },
    "From/SourceDeclarations::prefixHeading": {
      "common": [
        "$terms = [$chain->first];",
        "foreach (array_slice($chain->steps, 0, $position) as $step) {",
        "    $terms[] = $step->relation;",
        "}",
        "$fields = [];",
        "foreach ($terms as $occurrence => $term) {",
        "    foreach ($this->mergeHeading($operation, $term) as $name => $column) {",
        "        $fields[$name] ??= [$occurrence, $column];",
        "    }",
        "}",
        "",
        "return $fields;"
      ]
    }
  },
  "scope": "The admitted joined VALUES scope uses one shared definition and ordered references.",
  "extends": "sqlite-query-scope-boundaries-v8.json"
}
