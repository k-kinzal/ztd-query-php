  "scope": "Check table and absence roles, detached ordered targets, explicit modifier and matching native binding in the deployed classes. Exact persistent foreign-key placement and legacy order before publishing an admitted table removal.",
  "rules": {
    "Schema/Identity/AbsentDropTarget::__construct": {
