        "    } elseif ($temporaryOnly) {",
        "        \\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::input($target->kind === \\SqlSemantics\\Platform\\MySql\\Ir\\From\\ExternalRelationKind::TemporaryTable, 'DROP TEMPORARY TABLE requires session-local targets.');",
        "    }",
        "    $key = $target->quoted();",
        "    \\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::input(!isset($seen[$key]), 'DROP TABLE cannot repeat a target.');",
        "    $seen[$key] = true;",
