        "    $child = $positions[$reference->child->name->schema->value][$reference->child->name->table->value] ?? null;",
        "    \\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::input($parent !== null, 'A DROP TABLE dependency must name a selected persistent parent.');",
        "    \\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::input($child !== null, 'DROP TABLE must include every referencing persistent child.');",
        "    \\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::input(!$legacy || $child <= $parent, 'This MySQL release must drop a referencing child before its parent.');",
        "}"
      ]
    },
    "Schema/DropDependency/DropReferenceLowering::resolve": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "$references = [];",
        "foreach ($targets as $target) {",
