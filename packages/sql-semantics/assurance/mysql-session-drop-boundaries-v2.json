        "mysql"
      ],
      "common": [
        "$context = $operation->context;",
        "$profile = $context->profile;",
        "\\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::input($profile->parameters === \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\ParameterStyle::Native && $profile->lexical->equals(new \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\LexicalSettings()) && $context->relationNames === \\SqlSemantics\\Platform\\MySql\\Model\\Statement\\Identifier\\Comparison::Sensitive, 'DROP TABLE requires the default native profile.');",
        "$schemas = [$context->declarationSchema->value => true];",
        "foreach ($context->tables as $table) {",
