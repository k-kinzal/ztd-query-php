        "}",
        "$dependencies = \\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::listOf($references, \\SqlSemantics\\Platform\\MySql\\Ir\\Schema\\DropDependency\\TableDropReference::class, 'DROP TABLE requires a checked native dependency list.');",
        "(new \\SqlSemantics\\Platform\\MySql\\Ir\\Schema\\DropDependency\\DropTableDependencies())->check($checked, $dependencies, $release);",
