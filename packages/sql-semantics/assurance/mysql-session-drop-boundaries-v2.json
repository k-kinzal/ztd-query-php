        "    }",
        "    \\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::input($name->catalog === null && $schema !== \\SqlSemantics\\Platform\\MySql\\Rules\\SessionDatabase::UNNAMED, 'DROP TABLE needs an absolute table identity.');",
        "    $coordinate = new \\SqlSemantics\\Platform\\MySql\\Ir\\Schema\\TableName(new \\SqlSemantics\\Platform\\MySql\\Ir\\Identifier($schema), new \\SqlSemantics\\Platform\\MySql\\Ir\\Identifier($name->name->value));",
        "    $targets[] = $kind === null ? new \\SqlSemantics\\Platform\\MySql\\Ir\\Schema\\Identity\\AbsentDropTarget($coordinate) : new \\SqlSemantics\\Platform\\MySql\\Ir\\Schema\\Identity\\TableIdentity($coordinate, $kind);",
        "}",
