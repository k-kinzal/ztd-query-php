    "Schema/DropDependency/TableDropReference::__construct": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "\\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::input($child->kind === \\SqlSemantics\\Platform\\MySql\\Ir\\From\\ExternalRelationKind::BaseTable && $parent->kind === \\SqlSemantics\\Platform\\MySql\\Ir\\From\\ExternalRelationKind::BaseTable, 'A native foreign key relates two persistent tables.');"
      ]
    },
    "Schema/DropDependency/DropTableDependencies::check": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "$legacy = match ($release) {",
        "    \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\GrammarRelease::MySql5651, \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\GrammarRelease::MySql5744 => true,",
        "    \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\GrammarRelease::MySql8044, \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\GrammarRelease::MySql810, \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\GrammarRelease::MySql820, \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\GrammarRelease::MySql830, \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\GrammarRelease::MySql847, \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\GrammarRelease::MySql901, \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\GrammarRelease::MySql910 => false,",
        "};",
        "$positions = [];",
        "foreach ($targets as $index => $target) {",
        "    if ($target instanceof \\SqlSemantics\\Platform\\MySql\\Ir\\Schema\\Identity\\TableIdentity && $target->kind === \\SqlSemantics\\Platform\\MySql\\Ir\\From\\ExternalRelationKind::BaseTable) {",
        "        $positions[$target->name->schema->value][$target->name->table->value] = $index;",
