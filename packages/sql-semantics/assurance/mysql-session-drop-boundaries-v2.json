    "Schema/DropTable::__construct": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "\\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::input(array_is_list($targets) && $targets !== [], 'DROP TABLE needs a nonempty target list.');",
        "$seen = [];",
        "$checked = [];",
        "foreach ($targets as $target) {",
        "    \\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\Check::input($target instanceof \\SqlSemantics\\Platform\\MySql\\Ir\\Schema\\Identity\\TableIdentity || $target instanceof \\SqlSemantics\\Platform\\MySql\\Ir\\Schema\\Identity\\AbsentDropTarget, 'DROP TABLE requires checked target identities.');",
        "    if ($target instanceof \\SqlSemantics\\Platform\\MySql\\Ir\\Schema\\Identity\\AbsentDropTarget) {",
