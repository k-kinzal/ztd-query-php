  "scope": "Fix the shared absolute table-name delimiter used by the PostgreSQL partition rebuild renderer.",
  "rules": {
    "Schema/TableName::quoted": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "return $this->schema->quoted() . '.' . $this->table->quoted();"
      ]
    }
  }
}
