  "scope": "Verify the closed inventory value and native operation output with the exact quoted database scope.",
  "rules": {
    "Maintenance/Inventory/InventoryPragma::__construct": {
      "common": [
        ""
      ]
    },
    "Maintenance/Inventory/InventoryPragma::profileId": {
      "common": [
