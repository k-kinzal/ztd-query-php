{
  "revision": "SemanticsIR/sqlite-index-metadata-boundaries-1",
  "approval": "pending-human-review",
  "scope": "Verify complete native metadata, exact selector fallback precedence, stable primary storage and preservation of explicit absence scope.",
  "rules": {
    "Maintenance/Metadata/IndexInspection::__construct": {
      "common": [
        ""
      ]
    },
    "Maintenance/Metadata/IndexInspection::profileId": {
      "common": [
        "return 'sqlite-3.47.2/utf8/short-column-names/numbered-parameters';"
      ]
    },
    "Maintenance/Metadata/IndexInspection::toString": {
      "common": [
        "$schema = $this->target->schema;",
        "$name = $this->target->name;",
        "$qualifier = $schema === null ? '' : $schema->quoted() . '.';",
        "$argument = $name === null ? '' : '(' . $name->quoted() . ')';",
        "return 'PRAGMA ' . $qualifier . $this->kind->value . $argument;"
      ]
    },
    "Maintenance/Metadata/IndexMetadataLowering::lower": {
      "common": [
        "$context = $operation->context;",
        "$scope = (new PragmaScope())->resolve($context, $statement->name->schema);",
        "$value = $statement->value;",
        "if ($value === null) {",
        "    return new IndexInspection($kind, new EmptyIndexMetadata($scope));",
        "}",
        "$name = new Identifier($value instanceof PragmaNumber ? $value->nativeText() : $value->value);",
        "$qualified = new QualifiedName(new Name($name->value), $scope === null ? null : new Name($scope->value));",
        "$lookup = new MaintenanceLookup();",
        "$scopes = $lookup->scopes($context, $qualified->schema);",
        "$index = $lookup->index($context, $qualified, $scopes);",
        "if ($index !== null) {",
        "    return new IndexInspection($kind, $index);",
        "}",
        "Check::input($context->complete, 'Index metadata cannot establish absence in an open namespace.');",
        "$table = $lookup->relation($context, $qualified, $scopes);",
        "if ($table === null) {",
        "    $key = $name->key();",
        "    Check::input(!str_starts_with($key, 'pragma_') && $key !== 'json_each' && $key !== 'json_tree', 'Index metadata cannot establish a native module lookup from these declarations.');",
        "}",
        "$storage = $table === null || $table->kind === ExternalRelationKind::View ? null : $this->storage($context, $table);",
        "return new IndexInspection($kind, $storage ?? new EmptyIndexMetadata($scope, $name));"
      ]
    },
    "Maintenance/Metadata/IndexMetadataLowering::storage": {
      "common": [
        "$name = new Name($table->name->value);",
        "$schema = new Name($table->schema->value);",
        "$owners = $context->declared(new QualifiedName($name, $schema), $schema);",
        "Check::input(count($owners) === 1 && $owners[0]->complete, 'Index metadata needs an ordinary declared storage layout.');",
        "$comparison = $context->relationNames;",
        "$result = null;",
        "foreach ($context->indexes as $index) {",
        "    if ($index->primaryStorage && $comparison->equal($index->schema->value, $schema->value) && $comparison->equal($index->table->value, $name->value)) {",
        "        Check::input($result === null, 'A table has at most one native primary storage index.');",
        "        $result = new IndexTarget($table->schema, new Identifier($index->name->value), $table->name);",
        "    }",
        "}",
        "Check::input($result !== null || $owners[0]->implicit !== [] || $context->knowsConstraintIndexes($schema), 'Index metadata cannot infer absence from an opaque primary storage namespace.');",
        "return $result;"
      ]
    },
    "Maintenance/Metadata/EmptyIndexMetadata::__construct": {
      "common": [
        ""
      ]
    }
  }
}
