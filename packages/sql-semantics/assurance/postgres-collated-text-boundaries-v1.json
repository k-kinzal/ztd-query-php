{
  "revision": "SemanticsIR/postgres-collated-text-boundaries-1",
  "approval": "pending-human-review",
  "base": {
    "path": "native-boundaries-v31.json",
    "sha256": "3fca83f52f260bf9f43b909228eeed7f00d77534d2183368b530673364738b55"
  },
  "scope": "Hold an explicit stock collation with a checked typed operand and preserve it across projection rendering and typed set roles.",
  "rules": {
    "Expression/CollatedTextLowering::lower": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "Check::input(",
        "    array_column($expression->collation->parts, 'value') === ['pg_catalog', 'C'],",
        "    'A text projection requires the explicit pg_catalog.C collation.'",
        ");",
        "$operand = $expression->operand;",
        "while ($operand instanceof Grouped) {",
        "    $operand = $operand->operand;",
        "}",
        "Check::input(!$operand instanceof Collation, 'A checked text collation requires one native text operand.');",
        "$value = $operand instanceof ParsedColumn ? $binding->field($operand) : (new ExpressionLowering())->lower($operand, $binding, $catalogFirst, true);",
        "if ($value instanceof BuiltinCast && $value->target === CastDestination::Text && $value->operand instanceof NullLiteral) {",
        "    $value = $value->operand;",
        "}",
        "Check::input(",
        "    $value instanceof TextLiteral || $value instanceof TextColumnReference || $value instanceof NullLiteral,",
        "    'A checked text collation requires one native text operand.'",
        ");",
        "",
        "return new CollatedText($value, TextCollation::C);"
      ]
    },
    "ExpressionLowering::lower": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "while ($expression instanceof Grouped) {",
        "    $expression = $expression->operand;",
        "}",
        "if ($expression instanceof BinaryOperation) {",
        "    return $this->binary($expression, $binding, $catalogFirst);",
        "}",
        "$integer = $this->integerLiteral($expression, $catalogFirst);",
        "if ($integer !== null) {",
        "    return $integer;",
        "}",
        "",
        "return match (true) {",
        "    $expression instanceof Cast => (new BuiltinCastLowering())->lower($expression, $binding, $catalogFirst),",
        "    $expression instanceof Collation => (new CollatedTextLowering())->lower($expression, $binding, $catalogFirst),",
        "    $expression instanceof ParsedCase => (new IntegerCaseLowering())->lower($expression, $binding, $catalogFirst),",
        "    $expression instanceof ParsedDistinctness => (new IntegerDistinctnessLowering())->lower($expression, $binding, $catalogFirst),",
        "    $expression instanceof ParsedNullTest => (new PredicateLowering())->nullTest($expression, $binding, $catalogFirst),",
        "    $expression instanceof ParsedTruthTest => (new TruthTestLowering())->lower($expression, $binding, $catalogFirst),",
        "    $expression instanceof ParsedRange => (new IntegerRangeLowering())->lower($expression, $binding, $catalogFirst),",
        "    $expression instanceof Constant && $expression->value instanceof StringConstant && $simpleOutput => new TextLiteral($expression->value->value),",
        "    $expression instanceof ParsedBoolean => new BooleanLiteral($expression->value),",
        "    $expression instanceof ParsedNull => new NullLiteral(),",
        "    $expression instanceof ParsedColumn => $binding->reference($expression),",
        "    default => throw new InvalidConstruction('The operand has no complete PostgreSQL projection representation.'),",
        "};"
      ]
    },
    "SelectBounds::check": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "Check::input(count($results) <= 1024, 'A SELECT can have at most 1024 result columns in this profile.');",
        "$inputs = $source instanceof Join ? $source->inputs() : ($source === null ? [] : [$source]);",
        "$scope = new OccurrenceScope();",
        "$scope->predicate($where, $inputs);",
        "$nodes = 0;",
        "$positions = [];",
        "foreach ($results as $result) {",
        "    $pending = [[$result->expression, 0]];",
        "    while ($pending !== []) {",
        "        [$expression, $height] = array_pop($pending);",
        "        if ($expression instanceof IntegerRange || $expression instanceof IntegerDistinctness || $expression instanceof NullTest || $expression instanceof TruthTest) {",
        "            $nodes = $scope->checkTree($expression, $inputs, 'A tested predicate slot must belong to the SELECT source.', $height, $nodes);",
        "            continue;",
        "        }",
        "        Check::input($height <= 32 && ++$nodes <= 8192, 'Expression height or expanded node count exceeds the IR profile.');",
        "        if ($expression instanceof IntegerCase) {",
        "            foreach ($expression->arms as $arm) {",
        "                $nodes = $scope->checkTree($arm->condition, $inputs, 'A CASE condition slot must belong to the SELECT source.', $height + 1, $nodes);",
        "                $pending[] = [$arm->result, $height + 1];",
        "            }",
        "            if ($expression->otherwise !== null) {",
        "                $pending[] = [$expression->otherwise, $height + 1];",
        "            }",
        "            continue;",
        "        }",
        "        match (true) {",
        "            $expression instanceof ColumnReference, $expression instanceof TextColumnReference => $scope->column($expression, $inputs),",
        "            $expression instanceof BuiltinCast, $expression instanceof CollatedText => $pending[] = [$expression->operand, $height + 1],",
        "            $expression instanceof Arithmetic => array_push($pending, [$expression->right, $height + 1], [$expression->left, $height + 1]),",
        "            $expression instanceof Parameter => $positions[$expression->position] = ParameterSignature::typeFor($positions[$expression->position] ?? null, $expression),",
        "            $expression instanceof IntegerLiteral, $expression instanceof WideIntegerLiteral, $expression instanceof BooleanLiteral, $expression instanceof NullLiteral, $expression instanceof TextLiteral => null,",
        "        };",
        "    }",
        "}",
        "for ($position = 1; $position <= count($positions); ++$position) {",
        "    Check::input(isset($positions[$position]), 'PostgreSQL parameter positions must cover the contiguous bound slots.');",
        "}"
      ]
    },
    "SelectSql::expression": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "return match (true) {",
        "    $expression instanceof ColumnReference, $expression instanceof TextColumnReference => $this->column($expression, $source, $offset, $qualify),",
        "    $expression instanceof Arithmetic => '(' . $this->expression($expression->left, $source, $offset, $qualify) . ' OPERATOR(pg_catalog.' . $expression->operator->value . ') ' . $this->expression($expression->right, $source, $offset, $qualify) . ')',",
        "    $expression instanceof BuiltinCast => 'CAST(' . $this->expression($expression->operand, $source, $offset, $qualify) . ' AS pg_catalog.' . $expression->target->value . ')',",
        "    $expression instanceof IntegerCase => $this->integerCase($expression, $source, $offset, $qualify),",
        "    $expression instanceof IntegerDistinctness => $this->integerDistinctness($expression, $source, $offset, $qualify),",
        "    $expression instanceof IntegerRange => $this->integerRange($expression, $source, $offset, $qualify),",
        "    $expression instanceof NullTest => $this->predicate($expression, $source, $offset, $qualify),",
        "    $expression instanceof TruthTest => $this->truthTest($expression, $source, $offset, $qualify),",
        "    $expression instanceof IntegerLiteral => 'CAST(' . $expression->decimal . ' AS pg_catalog.int4)',",
        "    $expression instanceof WideIntegerLiteral => 'CAST(' . $expression->decimal . ' AS pg_catalog.int8)',",
        "    $expression instanceof TextLiteral => $expression->toString(),",
        "    $expression instanceof CollatedText => $this->collated($expression, $source, $offset, $qualify),",
        "    $expression instanceof NullLiteral => 'NULL',",
        "    $expression instanceof Parameter => $expression->toString(),",
        "    $expression instanceof BooleanLiteral => $expression->value ? 'TRUE' : 'FALSE',",
        "};"
      ]
    },
    "SelectSql::collated": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$operand = $expression->operand instanceof NullLiteral ? 'CAST(NULL AS pg_catalog.text)'",
        "    : $this->expression($expression->operand, $source, $offset, $qualify);",
        "",
        "return '(' . $operand . ' COLLATE pg_catalog.\"' . $expression->collation->value . '\")';"
      ]
    },
    "Predicate/PredicateLowering::nullTest": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$expression = new ExpressionLowering();",
        "$operand = $condition->operand;",
        "while ($operand instanceof Grouped) {",
        "    $operand = $operand->operand;",
        "}",
        "if ($operand instanceof ParsedColumn) {",
        "    return new NullTest($binding->field($operand), $condition->negated);",
        "}",
        "$tested = $operand instanceof ParsedLogical || $operand instanceof ParsedNot || $operand instanceof ParsedNullTest || $operand instanceof ParsedComparison",
        "    ? $this->lowerValue($operand, $binding, $catalogFirst)",
        "    : $expression->lower($operand, $binding, $catalogFirst);",
        "Check::input(!$tested instanceof Arithmetic && !$tested instanceof BuiltinCast && !$tested instanceof CollatedText && !$tested instanceof IntegerCase && !$tested instanceof WideIntegerLiteral && !$tested instanceof TextLiteral, 'A null test needs a supported scalar value.');",
        "",
        "return new NullTest($tested, $condition->negated);"
      ]
    },
    "Rows/CompoundShape::type": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "if ($query instanceof Compound) {",
        "    return self::merge(self::type($query->left, $position), self::type($query->right, $position));",
        "}",
        "$column = $query->columns[$position]->expression;",
        "",
        "return match (true) {",
        "    $column instanceof BuiltinCast, $column instanceof Parameter => match ($column instanceof BuiltinCast ? $column->target : $column->input) {",
        "        CastDestination::Integer => ResultKind::Integer,",
        "        CastDestination::WideInteger => ResultKind::WideInteger,",
        "        CastDestination::Boolean => ResultKind::Boolean,",
        "        CastDestination::Text => ResultKind::Text,",
        "    },",
        "    $column instanceof WideIntegerLiteral => ResultKind::WideInteger,",
        "    $column instanceof TextLiteral, $column instanceof TextColumnReference, $column instanceof CollatedText => ResultKind::Text,",
        "    $column instanceof NullLiteral => ResultKind::Unknown,",
        "    $column instanceof BooleanLiteral, $column instanceof IntegerRange, $column instanceof IntegerDistinctness, $column instanceof NullTest, $column instanceof TruthTest => ResultKind::Boolean,",
        "    $column instanceof Arithmetic, $column instanceof ColumnReference, $column instanceof IntegerCase, $column instanceof IntegerLiteral => ResultKind::Integer,",
        "};"
      ]
    }
  }
}
