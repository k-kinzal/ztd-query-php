    "Schema/Sequence/Access/RevokeSequenceAccess::__construct": {
      "dialects": [
        "postgres"
      ],
      "common": [
        ""
      ]
    },
    "Schema/Sequence/Access/RevokeSequenceAccess::profileId": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "return $this->access->profileId();"
      ]
    },
    "Schema/Sequence/Access/RevokeSequenceAccess::toString": {
