        "$recipients = \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::listOf($grantees, \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceGrantee::class, 'Sequence privileges require an ordered nonempty list of recipients.', 1);",
