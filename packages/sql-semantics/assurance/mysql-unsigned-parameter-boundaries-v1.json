        "return $target === \\SqlSemantics\\Platform\\MySql\\Statement\\Type\\Kind\\CastKind::Signed ? new \\SqlSemantics\\Platform\\MySql\\Ir\\Expression\\SignedCast($value) : new \\SqlSemantics\\Platform\\MySql\\Ir\\Expression\\UnsignedCast($value);"
      ]
