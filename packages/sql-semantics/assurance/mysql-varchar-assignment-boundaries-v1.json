{
  "revision": "SemanticsIR/mysql-varchar-assignment-boundaries-1",
  "approval": "pending-human-review",
  "base": {
    "path": "native-boundaries-v31.json",
    "sha256": "3fca83f52f260bf9f43b909228eeed7f00d77534d2183368b530673364738b55"
  },
  "scope": "Preserve column nullability and detach ordered native assignment roles after checking exact target and read positions.",
  "rules": {
    "From/VarcharLowering::lower": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "$type = $column->type;",
        "Check::input(",
        "    $type instanceof Character && ($type->kind === CharacterKind::VarChar || $type->kind === CharacterKind::CharVarying)",
        "        && !$column->generated && !$type->national && $type->length !== null && preg_match('/\\A[0-9]+\\z/', $type->length) === 1,",
        "    'The text slot requires an ordinary native VARCHAR with a character length.',",
        ");",
        "$collation = TextCollation::tryFrom(strtolower($column->collation->value ?? ''));",
        "Check::input($collation !== null, 'The text slot requires an explicit utf8mb4_bin collation.');",
        "$charset = $type->charset;",
        "Check::input(",
        "    $charset === null || (!$charset->binary() && strtolower($charset->charset->value ?? '') === 'utf8mb4'),",
        "    'The explicit VARCHAR collation requires the matching utf8mb4 character set.',",
        ");",
        "Check::input($column->nullability !== Nullability::Dependent, 'A native VARCHAR slot requires known column nullability.');",
        "return new Varchar((int) $type->length, $collation, $column->nullability === Nullability::Nullable);"
      ]
    },
    "From/OccurrenceScope::updateAssignment": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "$value = $assignment->value;",
        "if ($assignment instanceof TextUpdateAssignment) {",
        "    $this->textColumn($assignment->target, [$target]);",
        "    if ($value instanceof TextColumnReference) {",
        "        $this->textColumn($value, [$target]);",
        "    }",
        "    return;",
        "}",
        "$slot = $assignment->target->slot;",
        "Check::input(($target->columnTypes[$slot] ?? null) === ColumnKind::SignedInt, 'An UPDATE write slot must belong to the target.');",
        "Check::input(!$value instanceof ColumnReference || ($target->columnTypes[$value->slot] ?? null) === ColumnKind::SignedInt, 'An UPDATE read slot must belong to the target.');"
      ]
    },
    "Mutation/TextUpdateAssignment::__construct": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "Check::input($target->occurrence === 0, 'A VARCHAR UPDATE target slot must belong to occurrence zero.');",
        "Check::input(!$value instanceof TextColumnReference || $value->occurrence === 0, 'A VARCHAR UPDATE read slot must belong to occurrence zero.');"
      ]
    },
    "Mutation/Update::__construct": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "Check::input(array_is_list($assignments) && $assignments !== [], 'An UPDATE needs a nonempty assignment list.');",
        "Check::input(count($assignments) <= 1024, 'An UPDATE can have at most 1024 assignments.');",
        "$scope = new OccurrenceScope();",
        "$checked = [];",
        "foreach ($assignments as $assignment) {",
        "    Check::input($assignment instanceof UpdateAssignment || $assignment instanceof TextUpdateAssignment, 'An UPDATE needs a nonempty assignment list.');",
        "    $scope->updateAssignment($assignment, $target);",
        "    $checked[] = $assignment;",
        "}",
        "$scope->predicate($where, [$target]);",
        "$this->assignments = $checked;"
      ]
    },
    "Mutation/Update::toString": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "$sql = new SelectSql();",
        "$parts = [];",
        "foreach ($this->assignments as $assignment) {",
        "    $column = $this->target->columns[$assignment->target->slot]->quoted();",
        "    $parts[] = $column . ' = ' . $sql->expression($assignment->value, $this->target);",
        "}",
        "$statement = 'UPDATE ' . $sql->from($this->target) . ' SET ' . implode(', ', $parts);",
        "if ($this->where !== null) {",
        "    $statement .= ' WHERE ' . $sql->predicate($this->where, $this->target);",
        "}",
        "return $statement;"
      ]
    },
    "Mutation/UpdateAssignmentLowering::lower": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "$target = $binding->updateField($name);",
        "if ($target instanceof TextColumnReference) {",
        "    return new TextUpdateAssignment($target, $this->textValue($expression, $binding));",
        "}",
        "$value = (new ExpressionLowering())->lower($expression, $binding);",
        "Check::input($value instanceof ColumnReference || $value instanceof IntegerLiteral || $value instanceof NullLiteral, 'An UPDATE assignee requires a signed literal, NULL or a row reference.');",
        "return new UpdateAssignment($target, $value);"
      ]
    },
    "Mutation/UpdateAssignmentLowering::textValue": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "while ($expression instanceof Grouped) {",
        "    $expression = $expression->operand;",
        "}",
        "$value = match (true) {",
        "    $expression instanceof ColumnUse => $binding->field($expression),",
        "    $expression instanceof ParsedNull => new NullLiteral(),",
        "    default => (new TextLiteralLowering())->lower($expression),",
        "};",
        "Check::input($value instanceof TextColumnReference || $value instanceof TextLiteral || $value instanceof NullLiteral, 'A VARCHAR UPDATE requires a text literal, NULL or a VARCHAR read slot.');",
        "return $value;"
      ]
    },
    "Mutation/UpdateLowering::lower": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "$profile = $operation->context->profile;",
        "Check::input($profile->parameters === ParameterStyle::Native, 'The UPDATE requires the native language profile.');",
        "Check::input($profile->lexical->equals(new LexicalSettings()), 'This UPDATE profile requires the default lexical settings.');",
        "Check::input(",
        "    $statement->with === null && !$statement->lowPriority && !$statement->ignore",
        "    && count($statement->tables) === 1 && $statement->orderBy === [] && $statement->limit === null,",
        "    'A complete UPDATE requires one ordinary target.'",
        ");",
        "$binding = new SourceBinding($operation, $statement->tables[0]);",
        "$where = (new PredicateLowering())->lower($statement->where, $binding);",
        "$assignmentLowering = new UpdateAssignmentLowering();",
        "$assignments = [];",
        "foreach ($statement->assignments as $assignment) {",
        "    $assignments[] = $assignmentLowering->lower($assignment->column->name->value, $assignment->value, $binding);",
        "}",
        "$target = $binding->source();",
        "Check::input($target !== null, 'An UPDATE requires a resolved target.');",
        "return new Update($target, $assignments, $where, $profile->grammar);"
      ]
    },
    "SourceBinding::updateField": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "$column = $this->writeDeclaration($name);",
        "if (!$column->type instanceof Character) {",
        "    return $this->slotFor($this->signedWrite($column));",
        "}",
        "return new TextColumnReference($this->allocate($column, (new VarcharLowering())->lower($column)));"
      ]
    },
    "SourceBinding::writableColumn": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "return $this->signedWrite($this->writeDeclaration($name));"
      ]
    },
    "SourceBinding::writeDeclaration": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "Check::input($this->table !== null, 'A write requires a resolved base table.');",
        "$matches = $this->table->matchingColumns($name, $this->operation->context->columnNames);",
        "Check::input(count($matches) === 1 && in_array($matches[0], $this->table->columns, true), 'A write column must resolve to a declared target slot.');",
        "return $matches[0];"
      ]
    },
    "SourceBinding::signedWrite": {
      "dialects": [
        "mysql"
      ],
      "common": [
        "Check::input(!$column->generated && $column->type instanceof Integral && $column->type->kind === IntegralKind::Int && !$column->type->unsigned(), 'A write column must be a writable signed 32-bit integer.');",
        "return $column;"
      ]
    }
  }
}
