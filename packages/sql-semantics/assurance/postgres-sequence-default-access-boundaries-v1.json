{
  "revision": "SemanticsIR/postgres-sequence-default-access-boundaries-1",
  "approval": "pending-human-review",
  "base": {
    "path": "native-boundaries-v31.json",
    "sha256": "3fca83f52f260bf9f43b909228eeed7f00d77534d2183368b530673364738b55"
  },
  "scope": "Validate default sequence privilege dispatch, pinned decoded creator scopes, closed rights, detached operands and exact SQL construction.",
  "rules": {
    "Schema/Alter/RelationChangeLowering::lower": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "return match (true) {",
        "    $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Object\\Drop => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\DropRelationLowering())->lower($operation, $statement),",
        "    $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Object\\ChangeOwner, $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Object\\Rename && $statement->kind === \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Name\\ObjectKind::Schema => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Namespace\\SchemaAlterLowering())->lower($operation, $statement),",
        "    $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Object\\SetSchema => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Alter\\MoveSequenceLowering())->lower($operation, $statement),",
        "    $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Table\\Sequence\\AlterSequence => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Alter\\ReconfigureSequenceLowering())->lower($operation, $statement),",
        "    $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Table\\Alter\\AlterTable => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Authorization\\SequenceActionsLowering())->lower($operation, $statement),",
        "    $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Catalog\\Access\\Privilege\\Grant, $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Catalog\\Access\\Privilege\\Revoke => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceAccessLowering())->lower($operation, $statement),",
        "    $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Catalog\\Access\\Defaults\\AlterDefaultPrivileges => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Defaults\\SequenceDefaultLowering())->lower($operation, $statement),",
        "    $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Object\\Rename => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Alter\\RenameLowering())->lower($operation, $statement),",
        "    $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Table\\TruncateTable => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Truncate\\TruncateLowering())->lower($operation, $statement),",
        "    $statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Utility\\Maintenance\\Reindex => match ($statement->target) {",
        "        \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Utility\\Maintenance\\ReindexTarget::Index => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Index\\ReindexIndexLowering())->lower($operation, $statement),",
        "        \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Utility\\Maintenance\\ReindexTarget::Table => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Index\\ReindexTableLowering())->lower($operation, $statement),",
        "        \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Utility\\Maintenance\\ReindexTarget::Schema => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Index\\Scope\\ReindexSchemaLowering())->lower($operation, $statement),",
        "        \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Utility\\Maintenance\\ReindexTarget::System, \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Utility\\Maintenance\\ReindexTarget::Database => (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Index\\Scope\\ReindexDatabaseLowering())->lower($operation, $statement),",
        "    },",
        "};"
      ]
    },
    "Schema/Sequence/Access/SequenceAccessLowering::lower": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$context = $operation->context;",
        "\\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::input($context->profile->parameters === \\SqlSemantics\\Platform\\PostgreSql\\Model\\Contract\\ParameterStyle::Native && $context->relationNames === \\SqlSemantics\\Platform\\PostgreSql\\Model\\Statement\\Identifier\\Comparison::Sensitive, 'Sequence privileges require the native naming profile.');",
        "$target = (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceAccessTargetLowering())->lower($context, $statement->target);",
        "$owners = new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Namespace\\SchemaOwnerLowering();",
        "$grantor = $statement->grantor === null ? null : new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Authorization\\SequencePrincipal($owners->lower($context, $statement->grantor));",
        "$operands = new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequencePrivilegeLowering();",
        "$access = new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceAccess($target, $operands->rights($statement->privileges), $operands->grantees($context, $statement->grantees), $grantor, $context->profile->grammar);",
        "if ($statement instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Catalog\\Access\\Privilege\\Grant) {",
        "    return new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\GrantSequenceAccess($access, $statement->grantOption);",
        "}",
        "$dependency = match ($statement->behavior) {",
        "    \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Option\\DropBehavior::Cascade => \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceGrantDependency::Cascade,",
        "    null, \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Option\\DropBehavior::Restrict => \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceGrantDependency::Restrict,",
        "};",
        "return new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\RevokeSequenceAccess($access, $statement->grantOptionOnly, $dependency);"
      ]
    },
    "Schema/Sequence/Access/SequencePrivilegeLowering::grantees": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$owners = new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Namespace\\SchemaOwnerLowering();",
        "$grantees = [];",
        "foreach ($roles as $role) {",
        "    $grantees[] = new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceGrantee($role->kind === \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Name\\RoleSpecKind::Everyone ? \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\UniversalGrantee::Everyone : new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Authorization\\SequencePrincipal($owners->lower($context, $role)));",
        "}",
        "return $grantees;"
      ]
    },
    "Schema/Sequence/Access/SequencePrivilegeLowering::rights": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$rights = [];",
        "foreach ($privileges as $privilege) {",
        "    $word = match ($privilege->privilege()) {",
        "        'select' => \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceRight::Select,",
        "        'update' => \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceRight::Update,",
        "        'usage' => \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceRight::Usage,",
        "        'rule' => \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceRight::LegacyRule,",
        "        default => null,",
        "    };",
        "    \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::input($word !== null && $privilege->columns === [], 'A sequence privilege must name one native right without columns.');",
        "    $rights[] = $word;",
        "}",
        "return $rights;"
      ]
    },
    "Schema/Sequence/Defaults/SequenceDefaultScopesLowering::lower": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$creators = [];",
        "$schemas = [];",
        "$owner = new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Namespace\\SchemaOwnerLowering();",
        "$binding = new \\SqlSemantics\\Platform\\PostgreSql\\Model\\Facade\\Index\\IndexBinding();",
        "foreach ($scopes as $scope) {",
        "    if ($scope instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Catalog\\Access\\Defaults\\ForRoles) {",
        "        \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::input($creators === [], 'A default sequence privilege has one creator clause.');",
        "        foreach ($scope->roles as $role) {",
        "            $creators[] = new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Authorization\\SequencePrincipal($owner->lower($context, $role));",
        "        }",
        "        continue;",
        "    }",
        "    \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::input($scope instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Catalog\\Access\\Defaults\\InSchemas && $schemas === [], 'A default sequence privilege has one schema clause.');",
        "    foreach ($scope->schemas as $schema) {",
        "        \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::input($binding->known($context, $schema), 'Default sequence privileges require a declared schema.');",
        "        $schemas[] = new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Identifier($schema->value);",
        "    }",
        "}",
        "return [$creators, $schemas];"
      ]
    },
    "Schema/Sequence/Defaults/SequenceDefaultLowering::lower": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$context = $operation->context;",
        "$action = $statement->action;",
        "\\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::input($action->objects === \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Catalog\\Access\\Defaults\\DefaultObjectKind::Sequences && $context->profile->parameters === \\SqlSemantics\\Platform\\PostgreSql\\Model\\Contract\\ParameterStyle::Native && $context->relationNames === \\SqlSemantics\\Platform\\PostgreSql\\Model\\Statement\\Identifier\\Comparison::Sensitive, 'Default sequence privileges require ON SEQUENCES and the native naming profile.');",
        "[$creators, $schemas] = (new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Defaults\\SequenceDefaultScopesLowering())->lower($context, $statement->scopes);",
        "$lowering = new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequencePrivilegeLowering();",
        "$policy = new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Defaults\\SequenceDefaultPolicy($creators, $schemas, $lowering->rights($action->privileges), $lowering->grantees($context, $action->grantees), $context->profile->grammar);",
        "if ($action instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Catalog\\Access\\Defaults\\DefaultGrant) {",
        "    return new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Defaults\\GrantSequenceDefaults($policy, $action->grantOption);",
        "}",
        "$dependency = match ($action->behavior) {",
        "    \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Option\\DropBehavior::Cascade => \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceGrantDependency::Cascade,",
        "    null, \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Option\\DropBehavior::Restrict => \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceGrantDependency::Restrict,",
        "};",
        "return new \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Defaults\\RevokeSequenceDefaults($policy, $action->grantOptionOnly, $dependency);"
      ]
    },
    "Schema/Sequence/Defaults/SequenceDefaultPolicy::__construct": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$owners = \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::listOf($creators, \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Authorization\\SequencePrincipal::class, 'Default sequence privileges require an ordered list of creator roles.');",
        "foreach ($owners as $role) {",
        "    $role->checkRelease($release);",
        "}",
        "$namespaces = \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::listOf($schemas, \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Identifier::class, 'Default sequence privileges require an ordered list of schema identities.');",
        "foreach ($namespaces as $schema) {",
        "    \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::input($schema->value !== 'pg_temp' && !\\SqlSemantics\\Platform\\PostgreSql\\Model\\Contract\\Index\\IndexSchemas::sessionInternal($schema->value), 'Default sequence privileges require named persistent schemas.');",
        "}",
        "$recipients = \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::listOf($grantees, \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceGrantee::class, 'Default sequence privileges require an ordered nonempty list of recipients.', 1);",
        "foreach ($recipients as $role) {",
        "    $role->checkRelease($release);",
        "}",
        "$this->creators = $owners;",
        "$this->schemas = $namespaces;",
        "$this->rights = \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::listOf($rights, \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\SequenceRight::class, 'Default sequence privileges require an ordered list of rights.');",
        "$this->grantees = $recipients;"
      ]
    },
    "Schema/Sequence/Defaults/SequenceDefaultPolicy::profileId": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "return $this->release->value . '/utf8/standard-conforming-strings/native';"
      ]
    },
    "Schema/Sequence/Defaults/SequenceDefaultPolicy::scopeSql": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$owners = [];",
        "foreach ($this->creators as $role) {",
        "    $owners[] = $role->reference();",
        "}",
        "$schemas = [];",
        "foreach ($this->schemas as $schema) {",
        "    $schemas[] = $schema->quoted();",
        "}",
        "return 'ALTER DEFAULT PRIVILEGES' . ($owners === [] ? '' : ' FOR ROLE ' . implode(', ', $owners)) . ($schemas === [] ? '' : ' IN SCHEMA ' . implode(', ', $schemas));"
      ]
    },
    "Schema/Sequence/Defaults/SequenceDefaultPolicy::objectSql": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$names = [];",
        "foreach ($this->rights as $right) {",
        "    $names[] = $right->value;",
        "}",
        "return ($names === [] ? 'ALL' : implode(', ', $names)) . ' ON SEQUENCES';"
      ]
    },
    "Schema/Sequence/Defaults/SequenceDefaultPolicy::recipientsSql": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "$roles = [];",
        "foreach ($this->grantees as $role) {",
        "    $roles[] = $role->toString();",
        "}",
        "return implode(', ', $roles);"
      ]
    },
    "Schema/Sequence/Defaults/GrantSequenceDefaults::__construct": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "if ($grantOption) {",
        "    foreach ($policy->grantees as $grantee) {",
        "        \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::input($grantee->role !== \\SqlSemantics\\Platform\\PostgreSql\\Ir\\Schema\\Sequence\\Access\\UniversalGrantee::Everyone, 'Default sequence grant options require individual recipients.');",
        "    }",
        "}"
      ]
    },
    "Schema/Sequence/Defaults/GrantSequenceDefaults::profileId": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "return $this->policy->profileId();"
      ]
    },
    "Schema/Sequence/Defaults/GrantSequenceDefaults::toString": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "return $this->policy->scopeSql() . ' GRANT ' . $this->policy->objectSql() . ' TO ' . $this->policy->recipientsSql() . ($this->grantOption ? ' WITH GRANT OPTION' : '');"
      ]
    },
    "Schema/Sequence/Defaults/RevokeSequenceDefaults::__construct": {
      "dialects": [
        "postgres"
      ],
      "common": [
        ""
      ]
    },
    "Schema/Sequence/Defaults/RevokeSequenceDefaults::profileId": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "return $this->policy->profileId();"
      ]
    },
    "Schema/Sequence/Defaults/RevokeSequenceDefaults::toString": {
      "dialects": [
        "postgres"
      ],
      "common": [
        "return $this->policy->scopeSql() . ' REVOKE ' . ($this->grantOptionOnly ? 'GRANT OPTION FOR ' : '') . $this->policy->objectSql() . ' FROM ' . $this->policy->recipientsSql() . ' ' . $this->dependency->value;"
      ]
    }
  }
}
