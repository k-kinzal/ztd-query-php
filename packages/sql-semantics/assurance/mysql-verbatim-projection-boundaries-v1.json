        "foreach ($select->columns as $slot => $column) {",
        "    $name = $viewNames[$slot] ?? $column->name;",
        "    $label = $name->value;",
        "    $retain = $retainRequested && $name instanceof \\SqlSemantics\\Platform\\MySql\\Ir\\Ordering\\RequestedResultAlias;",
        "    $intrinsic = $label !== ltrim($label, \"\\x00.. \u007f\");",
        "    if ($localNames && !$retain) {",
        "        $alias = ' AS ' . $this->localColumn($slot);",
        "    } elseif ($name instanceof \\SqlSemantics\\Platform\\MySql\\Ir\\Literal\\IntrinsicIntegerName || $intrinsic) {",
        "        $alias = '';",
        "    } elseif ($name instanceof \\SqlSemantics\\Platform\\MySql\\Ir\\Ordering\\RequestedResultAlias) {",
        "        $alias = ' AS ' . $name->aliasSql();",
