        "    $lexical->equals(new \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\LexicalSettings('NO_BACKSLASH_ESCAPES')) => \\SqlSemantics\\Platform\\MySql\\Ir\\Binding\\ProjectionMode::NoBackslashEscapes,",
        "    $lexical->equals(new \\SqlSemantics\\Platform\\MySql\\Model\\Contract\\LexicalSettings('ANSI_QUOTES,NO_BACKSLASH_ESCAPES')) => \\SqlSemantics\\Platform\\MySql\\Ir\\Binding\\ProjectionMode::AnsiQuotesAndNoBackslashEscapes,",
        "    default => throw new \\SqlSemantics\\Platform\\MySql\\Model\\Diagnostic\\InvalidConstruction('A complete projection supports ANSI_QUOTES and NO_BACKSLASH_ESCAPES lexical modes.'),",
