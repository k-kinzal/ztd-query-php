        "\\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::input($reference instanceof \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Object\\Reference\\UnqualifiedName, 'ALTER SCHEMA requires an unqualified namespace selector.');",
        "\\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\Check::input((new \\SqlSemantics\\Platform\\PostgreSql\\Model\\Facade\\Index\\IndexBinding())->known($context, $reference->name), 'ALTER SCHEMA requires a declared source namespace.');",
