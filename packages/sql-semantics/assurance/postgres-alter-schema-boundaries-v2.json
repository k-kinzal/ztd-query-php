        "    \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Name\\RoleSpecKind::Named, \\SqlSemantics\\Platform\\PostgreSql\\Statement\\Name\\RoleSpecKind::Everyone => throw new \\SqlSemantics\\Platform\\PostgreSql\\Model\\Diagnostic\\InvalidConstruction('A schema requires a single owner.'),",
        "};"
