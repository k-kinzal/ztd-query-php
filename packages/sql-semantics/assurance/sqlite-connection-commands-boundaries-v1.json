{
  "revision": "SemanticsIR/sqlite-connection-commands-boundaries-1",
  "approval": "pending-human-review",
  "scope": "Close source-free connection operands and bind the exact native declaration or resolved attachment identity.",
  "rules": {
    "Connection/Attach::__construct": {
      "common": [
        "Check::input(count($file->values) === 1, 'ATTACH needs exactly one filename operand.');",
        "Check::input($key === null || count($key->values) === 1, 'ATTACH needs exactly one key operand when a key is present.');",
        "$pending = [[$file->values[0], 0, 0], [$name instanceof AttachmentName ? $name->literal : $name, 0, 0]];",
        "if ($key !== null) {",
        "    $pending[] = [$key->values[0], 0, 0];",
        "}",
        "(new ExpressionScope())->check([], $pending);"
      ]
    },
    "Connection/Attach::profileId": {
      "common": [
        "return 'sqlite-3.47.2/utf8/short-column-names/numbered-parameters';"
      ]
    },
    "Connection/Attach::toString": {
      "common": [
        "$name = $this->name instanceof AttachmentName ? $this->name->toString() : '?' . $this->name->label;",
        "$key = $this->key === null ? '' : ' KEY ' . $this->key->toString();",
        "return 'ATTACH ' . $this->file->toString() . ' AS ' . $name . $key;"
      ]
    },
    "Connection/AttachmentName::__construct": {
      "common": [
        "$value = match (true) {",
        "    $literal instanceof TextLiteral => explode(\"\\x00\", $literal->value, 2)[0],",
        "    $literal instanceof IntegerLiteral => $literal->decimal,",
        "    $literal instanceof NullLiteral => '',",
        "};",
        "$name = new Identifier($value);",
        "Check::input($name->key() !== 'main' && $name->key() !== 'temp', 'A constant attachment name cannot select a builtin database.');",
        "$this->name = $name;"
      ]
    },
    "Connection/AttachmentName::toString": {
      "common": [
        "return (new SelectSql())->expression($this->literal, null);"
      ]
    },
    "Connection/Detach::__construct": {
      "common": [
        "$value = $target instanceof DetachTarget ? $target->name->literal : $target;",
        "(new ExpressionScope())->check([], [[$value, 0, 0]]);"
      ]
    },
    "Connection/Detach::profileId": {
      "common": [
        "return 'sqlite-3.47.2/utf8/short-column-names/numbered-parameters';"
      ]
    },
    "Connection/Detach::toString": {
      "common": [
        "$name = $this->target instanceof DetachTarget ? $this->target->name->toString() : '?' . $this->target->label;",
        "return 'DETACH ' . $name;"
      ]
    },
    "Connection/DetachTarget::__construct": {
      "common": [
        "Check::input($schema->key() === $name->name->key(), 'The DETACH name must match its resolved database.');"
      ]
    },
    "Connection/ConnectionLowering::lower": {
      "common": [
        "$operands = new ConnectionOperands();",
        "$name = $operands->name($operation, $statement->schema);",
        "if ($statement instanceof ParsedAttach) {",
        "    $file = $operands->row($operation, $statement->file);",
        "    $key = $statement->key === null ? null : $operands->row($operation, $statement->key);",
        "    return new Attach($file, $name, $key);",
        "}",
        "if ($name instanceof Parameter) {",
        "    return new Detach($name);",
        "}",
        "$scope = (new MaintenanceLookup())->scopes($operation->context, new Name($name->name->value))[0];",
        "return new Detach(new DetachTarget(new Identifier($scope->value), $name));"
      ]
    },
    "Connection/ConnectionOperands::row": {
      "common": [
        "while ($expression instanceof Grouped) {",
        "    $expression = $expression->operand;",
        "}",
        "$value = $expression instanceof NameOperand ? new TextLiteral($expression->name->value) : (new ExpressionLowering())->lower($expression, new SourceBinding($operation, null));",
        "return new ValueRow([$value]);"
      ]
    },
    "Connection/ConnectionOperands::name": {
      "common": [
        "$value = $this->row($operation, $expression)->values[0];",
        "if ($value instanceof Parameter) {",
        "    return $value;",
        "}",
        "Check::input($value instanceof TextLiteral || $value instanceof IntegerLiteral || $value instanceof NullLiteral, 'An SQLite connection name requires a checked constant or numbered parameter.');",
        "return new AttachmentName($value);"
      ]
    }
  }
}
