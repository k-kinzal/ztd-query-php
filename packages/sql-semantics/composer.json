{
    "name": "k-kinzal/sql-semantics",
    "description": "Typed SQL statement analysis and reconstruction, with schema-dependent binding and value provenance",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "k-kinzal/sql-parser": "dev-main"
    },
    "require-dev": {
        "brianium/paratest": "^7.3",
        "deptrac/deptrac": "^3.0",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.95.25",
        "k-kinzal/bison-parser": "dev-main",
        "k-kinzal/lemon-parser": "dev-main",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "k-kinzal/sql-faker": "dev-main",
        "k-kinzal/sql-formatter": "dev-main",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        },
        {
            "type": "path",
            "url": "../sql-parser",
            "options": {
                "versions": {
                    "k-kinzal/sql-parser": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../sql-faker",
            "options": {
                "versions": {
                    "k-kinzal/sql-faker": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../sql-formatter",
            "options": {
                "versions": {
                    "k-kinzal/sql-formatter": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../bison-parser",
            "options": {
                "versions": {
                    "k-kinzal/bison-parser": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../lemon-parser",
            "options": {
                "versions": {
                    "k-kinzal/lemon-parser": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "SqlSemantics\\": "src/",
            "SqlSemantics\\Statement\\Model\\": "resources/models/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Bench\\": "bench/",
            "Fuzz\\": "fuzz/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "autoload:check": "composer dump-autoload --optimize --strict-psr --strict-ambiguous",
        "bench": "phpbench run --report=aggregate",
        "bench:full": "@bench",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
        "build:models": "@php -d memory_limit=1G bin/build-models.php",
        "build:models:check": "@build:models --check",
        "compat": "phpcs",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered --report-uncovered",
        "docgen": "docgen --packages=. --title=k-kinzal/sql-semantics",
        "docgen:diff": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --diff=origin/main --serve"
        ],
        "docgen:fresh": "@docgen --no-cache",
        "docgen:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --serve"
        ],
        "doctest": "phpunit --testsuite doctest",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz": "@fuzz:smoke",
        "fuzz:mysql": [
            "Composer\\Config::disableProcessTimeout",
            "@fuzz:seeds:mysql --",
            "@php fuzz/run.php mysql"
        ],
        "fuzz:pg": [
            "Composer\\Config::disableProcessTimeout",
            "@fuzz:seeds:pg --",
            "@php fuzz/run.php pg"
        ],
        "fuzz:seeds": [
            "@fuzz:seeds:mysql",
            "@fuzz:seeds:pg",
            "@fuzz:seeds:sqlite"
        ],
        "fuzz:seeds:mysql": "@php fuzz/seed.php mysql",
        "fuzz:seeds:pg": "@php fuzz/seed.php pg",
        "fuzz:seeds:sqlite": "@php fuzz/seed.php sqlite",
        "fuzz:smoke": [
            "Composer\\Config::disableProcessTimeout",
            "@fuzz:mysql --max-runs=100",
            "@fuzz:pg --max-runs=100",
            "@fuzz:sqlite --max-runs=100"
        ],
        "fuzz:sqlite": [
            "Composer\\Config::disableProcessTimeout",
            "@fuzz:seeds:sqlite --",
            "@php fuzz/run.php sqlite"
        ],
        "lint": [
            "@autoload:check",
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "loc-guard": "loc-guard --config=loc.yaml",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "paratest --processes=auto",
        "test:coverage": "@php -d memory_limit=1G vendor/bin/paratest --processes=auto --testsuite unit --coverage-xml build/coverage-xml --log-junit build/junit.xml",
        "test:unit": "phpunit --testsuite unit",
        "tree-guard": "tree-guard --config=tree.yaml"
    },
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/sql-semantics",
        "docs": "https://k-kinzal.github.io/ztd-query-php/k-kinzal/sql-semantics/"
    },
    "scripts-descriptions": {
        "fuzz": "Run the round-trip property for all three databases with a bounded smoke budget.",
        "fuzz:seeds": "Copy the sql-faker seed plans into each corpus.",
        "fuzz:smoke": "Replay the corpus and run 100 mutations per database."
    }
}
