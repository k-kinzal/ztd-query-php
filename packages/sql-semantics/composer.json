{
    "name": "k-kinzal/sql-semantics",
    "description": "SQL semantic binding: schema declarations, bound statements, types, nullability, and value provenance",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "k-kinzal/sql-parser": "dev-main"
    },
    "require-dev": {
        "brianium/paratest": "^7.3",
        "deptrac/deptrac": "^3.0",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95.25",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "k-kinzal/sql-faker": "dev-main",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.4",
        "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        },
        {
            "type": "path",
            "url": "../sql-parser",
            "options": {
                "versions": {
                    "k-kinzal/sql-parser": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../sql-faker",
            "options": {
                "versions": {
                    "k-kinzal/sql-faker": "dev-main"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "SqlSemantics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Bench\\": "bench/",
            "Fuzz\\": "fuzz/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "autoload:check": "composer dump-autoload --optimize --strict-psr --strict-ambiguous",
        "bench": "phpbench run --report=aggregate",
        "bench:full": "@bench",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
        "compat": "phpcs",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered --report-uncovered",
        "docgen": "docgen --packages=. --title=k-kinzal/sql-semantics",
        "docgen:diff": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --diff=origin/main --serve"
        ],
        "docgen:fresh": "@docgen --no-cache",
        "docgen:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@docgen --serve"
        ],
        "doctest": "phpunit --testsuite doctest",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "fuzz": "@fuzz:smoke",
        "fuzz:mysql": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"is_dir('fuzz/corpus/mysql') || mkdir('fuzz/corpus/mysql', 0777, true);\" --",
            "@php -d memory_limit=2G vendor/bin/php-fuzzer fuzz fuzz/fuzz_mysql_semantics.php fuzz/corpus/mysql/ --timeout=10"
        ],
        "fuzz:pg": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"is_dir('fuzz/corpus/pg') || mkdir('fuzz/corpus/pg', 0777, true);\" --",
            "@php -d memory_limit=2G vendor/bin/php-fuzzer fuzz fuzz/fuzz_pg_semantics.php fuzz/corpus/pg/ --timeout=10"
        ],
        "fuzz:smoke": [
            "Composer\\Config::disableProcessTimeout",
            "@fuzz:mysql --max-runs=100",
            "@fuzz:pg --max-runs=100",
            "@fuzz:sqlite --max-runs=100"
        ],
        "fuzz:sqlite": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"is_dir('fuzz/corpus/sqlite') || mkdir('fuzz/corpus/sqlite', 0777, true);\" --",
            "@php -d memory_limit=2G vendor/bin/php-fuzzer fuzz fuzz/fuzz_sqlite_semantics.php fuzz/corpus/sqlite/ --timeout=10"
        ],
        "lint": [
            "@autoload:check",
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "loc-guard": "loc-guard --config=loc.yaml",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "paratest --processes=auto",
        "test:coverage": "@php -d memory_limit=1G vendor/bin/paratest --processes=auto --testsuite unit --coverage-xml build/coverage-xml --log-junit build/junit.xml",
        "test:unit": "phpunit --testsuite unit",
        "tree-guard": "tree-guard --config=tree.yaml",
        "fuzz:seeds": [
            "Composer\\Config::disableProcessTimeout",
            "@fuzz:seeds:mysql",
            "@fuzz:seeds:pg",
            "@fuzz:seeds:sqlite"
        ],
        "fuzz:seeds:mysql": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv MYSQL_VERSION=8.4.7",
            "@putenv SQLFAKER_COVERAGE=0",
            "@php -d memory_limit=-1 vendor/bin/php-fuzzer fuzz fuzz/fuzz_mysql_semantics.php ../sql-faker/seeds/mysql/mysql-8.4.7/ --max-runs=0 --timeout=60"
        ],
        "fuzz:seeds:pg": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv SQLFAKER_COVERAGE=0",
            "@php -d memory_limit=-1 vendor/bin/php-fuzzer fuzz fuzz/fuzz_pg_semantics.php ../sql-faker/seeds/pg/pg-17.2/ --max-runs=0 --timeout=60"
        ],
        "fuzz:seeds:sqlite": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv SQLFAKER_COVERAGE=0",
            "@php -d memory_limit=-1 vendor/bin/php-fuzzer fuzz fuzz/fuzz_sqlite_semantics.php ../sql-faker/seeds/sqlite/sqlite-3.47.2/ --max-runs=0 --timeout=60"
        ]
    },
    "support": {
        "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/sql-semantics",
        "docs": "https://k-kinzal.github.io/ztd-query-php/k-kinzal/sql-semantics/"
    },
    "scripts-descriptions": {
        "fuzz": "Run every fuzz target with the bounded smoke budget.",
        "fuzz:smoke": "Run each fuzz target for 100 mutation iterations after corpus replay; individual fuzz:* commands run continuously.",
        "fuzz:seeds": "Replay sql-faker's grammar coverage seeds through each fuzz target once, without mutation (local check; not run in CI)."
    }
}
