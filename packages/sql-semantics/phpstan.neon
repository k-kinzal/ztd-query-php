includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    toolkit:
        visibilityExemptNamespacePrefixes: ['Tests', 'Bench']
        forbiddenTermsByPath:
            'src/Construction/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Resolution/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Rendering/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Lowering/*': [mysql, postgres, pgsql, sqlite, mariadb]
            'src/Validation/*': [mysql, postgres, pgsql, sqlite, mariadb]
        forbiddenNamespacePrefixes: ['Tests\Fixture', 'Tests\Fixtures']
    phpVersion: 80100
    level: max
    paths: [src, tests, bench]
