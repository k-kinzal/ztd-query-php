e":1790153056.501346,"turn_id":"01a0ccb0-75a7-7862-941a-ed4430a5b3b7"},"output":[{"text":"Script completed\nWall time 2.7 seconds\nOutput:\n","type":"input_text"},{"text":"{\"i\":0,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"321882\",\"wall_time_seconds\":0.000005083,\"exit_code\":0,\"original_token_count\":1335,\"output\":\"/tmp/semantics-mysql-5.6.51.y:2518:server_def:\\n/tmp/semantics-mysql-5.6.51.y:2536:server_options_list:\\n/tmp/semantics-mysql-5.6.51.y:2541:server_option:\\n/tmp/semantics-mysql-5.6.51.y:5067:opt_ts_engine:\\n/tmp/semantics-mysql-8.4.7.y:3488:server_options_list:\\n/tmp/semantics-mysql-8.4.7.y:3493:server_option:\\n/tmp/semantics-mysql-8.4.7.y:8234:alter_server_stmt:\\n/tmp/semantics-mysql-8.4.7.y:12904:drop_tablespace_stmt:\\n/tmp/semantics-mysql-8.4.7.y:12924:drop_undo_tablespace_stmt:\\n/tmp/semantics-mysql-8.4.7.y:12946:drop_logfile_stmt:\\n            lex-\u003esql_command= SQLCOM_HELP;\\n            lex-\u003ehelp_arg= $3.str;\\n          }\\n        ;\\n\\n/* change replication source */\\n\\nchange_replication_stmt:\\n          CHANGE REPLICATION SOURCE_SYM TO_SYM\\n          {\\n            LEX *lex = Lex;\\n            lex-\u003esql_command = SQLCOM_CHANGE_REPLICATION_SOURCE;\\n            /*\\n              Clear LEX_SOURCE_INFO struct. repl_ignore_server_ids is cleared\\n              in THD::cleanup_after_query. So it is guaranteed to be empty here.\\n            */\\n            assert(Lex-\u003emi.repl_ignore_server_ids.empty());\\n            lex-\u003emi.set_unspecified();\\n          }\\n          source_defs opt_channel\\n          {\\n            if (Lex-\u003eset_channel_name($7))\\n              MYSQL_YYABORT;  // OOM\\n          }\\n        | CHANGE REPLICATION FILTER_SYM\\n          {\\n            THD *thd= YYTHD;\\n            LEX* lex= thd-\u003elex;\\n            assert(lex-\u003em_sql_cmd == nullptr);\\n            lex-\u003esql_command = SQLCOM_CHANGE_REPLICATION_FILTER;\\n            lex-\u003em_sql_cmd= NEW_PTN Sql_cmd_change_repl_filter();\\n            if (lex-\u003em_sql_cmd == nullptr)\\n              MYSQL_YYABORT;\\n          }\\n          filter_defs opt_channel\\n          {\\n            if (Lex-\u003eset_channel_name($6))\\n              MYSQL_YYABORT;  // OOM\\n          }\\n        ;\\n\\nfilter_defs:\\n          filter_def\\n        | filter_defs ',' filter_def\\n        ;\\nfilter_def:\\n          REPLICATE_DO_DB EQ opt_filter_db_list\\n          {\\n            Sql_cmd_change_repl_filter * filter_sql_cmd=\\n              (Sql_cmd_change_repl_filter*) Lex-\u003em_sql_cmd;\\n            assert(filter_sql_cmd != nullptr);\\n            filter_sql_cmd-\u003eset_filter_value($3, OPT_REPLICATE_DO_DB);\\n          }\\n        | REPLICATE_IGNORE_DB EQ opt_filter_db_list\\n          {\\n            Sql_cmd_change_repl_filter * filter_sql_cmd=\\n              (Sql_cmd_change_repl_filter*) Lex-\u003em_sql_cmd;\\n            assert(filter_sql_cmd != nullptr);\\n            filter_sql_cmd-\u003eset_filter_value($3, OPT_REPLICATE_IGNORE_DB);\\n          }\\n        | REPLICATE_DO_TABLE EQ opt_filter_table_list\\n          {\\n            Sql_cmd_change_repl_filter * filter_sql_cmd=\\n              (Sql_cmd_change_repl_filter*) Lex-\u003em_sql_cmd;\\n            assert(filter_sql_cmd != nullptr);\\n            filter_sql_cmd-\u003eset_filter_value($3, OPT_REPLICATE_DO_TABLE);\\n          }\\n        | REPLICATE_IGNORE_TABLE EQ opt_filter_table_list\\n          {\\n            Sql_cmd_change_repl_filter * filter_sql_cmd=\\n              (Sql_cmd_change_repl_filter*) Lex-\u003em_sql_cmd;\\n            assert(filter_sql_cmd != nullptr);\\n            filter_sql_cmd-\u003eset_filter_value($3, OPT_REPLICATE_IGNORE_TABLE);\\n          }\\n        | REPLICATE_WILD_DO_TABLE EQ opt_filter_string_list\\n          {\\n            Sql_cmd_change_repl_filter * filter_sql_cmd=\\n              (Sql_cmd_change_repl_filter*) Lex-\u003em_sql_cmd;\\n            assert(filter_sql_cmd != nullptr);\\n            filter_sql_cmd-\u003eset_filter_value($3, OPT_REPLICATE_WILD_DO_TABLE);\\n          }\\n        | REPLICATE_WILD_IGNORE_TABLE EQ opt_filter_string_list\\n          {\\n            Sql_cmd_change_repl_filter * filter_sql_cmd=\\n              (Sql_cmd_change_repl_filter*) Lex-\u003em_sql_cmd;\\n            assert(filter_sql_cmd != nullptr);\\n            filter_sql_cmd-\u003eset_filter_value($3,\\n                                             OPT_REPLICATE_WILD_IGNORE_TABLE);\\n          }\\n        | REPLICATE_REWRITE_DB EQ opt_filter_db_pair_list\\n          {\\n            Sql_cmd_change_repl_filter * filter_sql_cmd=\\n              (Sql_cmd_change_repl_filter*) Lex-\u003em_sql_cmd;\\n            assert(filter_sql_cmd != nullptr);\\n            filter_sql_cmd-\u003eset_filter_value($3, OPT_REPLICATE_REWRITE_DB);\\n          }\\n        ;\\nopt_filter_db_list:\\n          '(' ')'\\n          {\\n            $$= NEW_PTN mem_root_deque\u003cItem *\u003e(YYMEM_ROOT);\\n            if ($$ == nullptr)\\n              MYSQL_YYABORT;\\n          }\\n        | '(' filter_db_list ')'\\n          {\\n            $$= $2;\\n          }\\n        ;\\n\\nfilter_db_list:\\n          filter_db_ident\\n          {\\n            $$= NEW_PTN mem_root_deque\u003cItem *\u003e(YYMEM_ROOT);\\n            if ($$ == nullptr)\\n              MYSQL_YYABORT;\\n            $$-\u003epush_back($1);\\n          }\\n        | filter_db_list ',' filter_db_ident\\n          {\\n            $1-\u003epush_back($3);\\n            $$= $1;\\n          }\\n        ;\\n\\nfilter_db_ident:\\n          ident /* DB name */\\n          {\\n            THD *thd= YYTHD;\\n            Item *db_item= NEW_PTN Item_string($1.str, $1.length,\\n                                               thd-\u003echarset());\\n4768:  DROP TABLESPACE name\\n4769:  DROP LOGFILE GROUP_SYM name\\n7507:        | ALTER SERVER_SYM ident_or_text OPTIONS_SYM '(' server_options_list ')'\\n11903:        | DROP TABLESPACE tablespace_name drop_ts_options_list\\n11908:        | DROP LOGFILE_SYM GROUP_SYM logfile_group_name drop_ts_options_list\\n\"}}","type":"input_text"},{"text":"{\"i\":1,\"status\":\"fulfilled\",\"value\":\"MySQL :: MySQL 8.4 Reference Manual :: 15.1.18 CREATE SERVER Statement (https://dev.mysql.com/doc/refman/8.4/en/create-server.html)\\nciteturn102view0 [wordlim: 200] Crawled: today; Content type: text/html; Source: open({\\\"ref_id\\\":\\\"https://dev.mysql.com/doc/refman/8.4/en/create-server.html\\\",\\\"lineno\\\":null}); Total lines: 683\\nL0: cite0†Skip to Main Content L1: \\nL2: The world's most popular open source database\\nL3: \\nL4: [Input] [Input: Search]\\nL5: \\nL6: cite1†Developer Zone cite2†Downloads†www.mysql.com cite3†MySQL.com†www.mysql.com L7: \\nL8: cite4†Documentation L9: \\nL10: Section Menu:\\nL11: \\nL12: [Input] [Input] [Input]\\nL13: \\nL14: cite4†Documentation Home L15: \\nL16: * * *\\nL17: \\nL18: MySQL 8.4 Reference Manual\\nL19: \\nL20:   * cite5†Preface and Legal Notices L21: \\nL22:   * cite6†General Information L23: \\nL24:   * cite7†Installing MySQL L25: \\nL26:   * cite8†Upgrading MySQL L27: \\nL28:   * cite9†Downgrading MySQL L29: \\nL30:   * cite10†Tutorial L31: \\nL32:   * cite11†MySQL Programs L33:   * cite12†MySQL Server Administration L34: \\nL35:   * cite13†Security L36: \\nL37:   * cite14†Backup and Recovery L38: \\nL39:   * cite15†Optimization L40: \\nL41:   * cite16†Language Structure L42: \\nL43:   * cite17†Character Sets, Collations, Unicode L44: \\nL45:   * cite18†Data Types L46: \\nL47:   * cite19†Functions and Operators L48: \\nL49:   * cite20†SQL Statements L50: \\nL51:     * cite21†Data Definition Statements L52: \\nL53:       * cite22†Atomic Data Definition Statement Support L54: \\nL55:       * cite23†ALTER DATABASE Statement L56: \\nL57:       * cite24†ALTER EVENT Statement L58: \\nL59:       * cite25†ALTER FUNCTION Statement