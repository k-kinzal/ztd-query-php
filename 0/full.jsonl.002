ric parameters.\n    public static function read(Node $source, ?Node $bounds): array\n    {\n        $dimensions = [];\n        $size = '';\n        $inside = false;\n        $tokens = $bounds !== null ? $bounds->tokens() : array_merge(...array_map(static fn ($child): array => $child instanceof \\SqlParser\\Lexer\\Token ? [$child] : ($child->name === 'Iconst' ? $child->tokens() : []), $source->children));\n        foreach ($tokens as $token) {\n            if ($token->text === '[') {\n                $inside = true;\n                $size = '';\n            } elseif ($token->text === ']') {\n                $dimensions[] = new ArrayDimension($size === '' ? null : new NumericParameter($size));\n                $inside = false;\n            } elseif ($inside) {\n                $size .= $token->text;\n            }\n        }\n        return $dimensions === [] ? [new ArrayDimension()] : $dimensions;\n    }\n}\nPHPUnit 10.5.64 by Sebastian Bergmann and contributors.\n\nRuntime:       PHP 8.5.8\nConfiguration: /Users/ab/Projects/ztd-query-php-worktrees/sql-semantics-versioned-language/packages/sql-semantics/phpunit.xml.dist\nRandom Seed:   1790156858\n\n.............................................................   61 / 2904 (  2%)\n.............................................................  122 / 2904 (  4%)\n.............................................................  183 / 2904 (  6%)\n.............................................................  244 / 2904 (  8%)\n.............................................................  305 / 2904 ( 10%)\n.......................\nTime: 00:05.353, Memory: 48.78 MB\n\nOK (325 tests, 325 assertions)\n","stderr":"","aggregated_output":"    /**\n     * Returns the concrete type identity without storing a syntax payload.\n     */\n    public function read(Node $source): TypeDescriptor\n    {\n        if ($this->types->dialect === Dialect::Sqlite) {\n            return $this->sqlite($source);\n        }\n        $simple = Tree