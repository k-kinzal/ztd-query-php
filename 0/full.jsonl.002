mes.php').write_text('''<?php\n\ndeclare(strict_types=1);\n\nnamespace SqlSemantics\\\\Ast;\n\nuse SqlParser\\\\Lexer\\\\Token;\n\n/**\n * Decodes identifier-or-text names with MySQL lexical escaping.\n * @visibility SqlSemantics\n */\nfinal class MySqlNames\n{\n    /**\n     * Preserves identifier case and decodes literal bytes without evaluating SQL.\n     */\n'''+body.replace('function part(', 'function read(')+'\\n}\\n');p.write_text(t[:start]+'''    public static function part(Token $token, Identifiers $identifiers): string\n    {\n        return \\\\SqlSemantics\\\\Ast\\\\MySqlNames::read($token, $identifiers);\n    }\n}\n''')\np=Path('src/Binding/Statement/Definition/Database/OptionValues.php');t=p.read_text();start=t.index('        $name = $identifiers->name($token);');end=t.index('\\n    }',start);t=t[:start]+'        return \\\\SqlSemantics\\\\Ast\\\\MySqlNames::read($token, $identifiers);'+t[end:];p.write_text(t)\nPY\ncomposer format > /tmp/semantics-database-format.log 2>&1\ncomposer tree-guard > /tmp/semantics-database-tree.log 2>&1"}],"source":"unified_exec_startup","status":"completed","stdout":"","stderr":"","aggregated_output":"","exit_code":0,"duration":{"secs":1,"nanos":646380958},"formatted_output":""},"started_at_ms":1790152558315,"completed_at_ms":1790152559961}}
