LE t'])]\\n    #[TestWith(['SELECT 1'])]\\n    public function testWriteReturnsNullForOtherSemanticFamilies(string $sql): void\\n    {\\n        $binder = new Binder((new SchemaBuilder(Dialect::PostgreSql))->build('CREATE TABLE t(id integer)'));\\n        self::assertNull(\\\\SqlSemantics\\\\Serialization\\\\Definition\\\\Trigger\\\\EventTriggerCommands::write($binder->bind($sql)));\\n    }\\n''')\\nPY\\npython3 /tmp/semantics-event-trigger-tests.py\\ncomposer format > /tmp/semantics-event-trigger-format.log 2>&1\\nphp -d memory_limit=1G vendor/bin/phpunit --testsuite unit > /tmp/semantics-event-trigger-full-unit.log 2>&1\\nphp -d memory_limit=1G vendor/bin/phpunit --testsuite doctest > /tmp/semantics-event-trigger-doctest.log 2>&1\\ncomposer phpstan -- --error-format=json > /tmp/semantics-event-trigger-phpstan.json 2>/tmp/semantics-event-trigger-phpstan.stderr\",workdir:\"/Users/ab/Projects/ztd-query-php-worktrees/sql-semantics-versioned-language/packages/sql-semantics\",yield_time_ms:1000,max_output_tokens:800}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a0ccb0-75a7-7862-941a-ed4430a5b3b7","create_time":1790155043.201624}}}
