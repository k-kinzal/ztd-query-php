tom ? [$child] : $child->atoms()));\n        }\n        return $result;\n    }\n\n    /**\n     * Writes the standard compact layout.\n     */\n    public function toString(): string\n    {\n        return Format::write($this->atoms());\n    }\n}\n<?php\n\ndeclare(strict_types=1);\n\nnamespace SqlSemantics\\Model\\Sql;\n\n/**\n * Chooses token boundaries without retaining source whitespace or ordinary comments.\n *\n * @visibility SqlSemantics\n */\nfinal class Format\n{\n    /**\n     * @param list<Atom> $atoms\n     */\n    public static function write(array $atoms): string\n    {\n        $sql = '';\n        $previous = null;\n        foreach ($atoms as $atom) {\n            if ($atom->text === '') {\n                continue;\n            }\n            $sql .= $previous === null || self::adjacent($previous, $atom) ? '' : ' ';\n            $sql .= $atom->text;\n            $previous = $atom;\n        }\n        return $sql;\n    }\n\n    /**\n     * Keeps punctuation tight while preventing separate operators from becoming a comment.\n     */\n    public static function adjacent(Atom $left, Atom $right): bool\n    {\n        if ($left->kind === 'annotation' || $right->kind === 'annotation') {\n            return false;\n        }\n        if (in_array($right->text, [',', ';', ')', ']', '['], true) || in_array($left->text, ['(', '[', '@', '@@'], true)) {\n            return true;\n        }\n        if ($right->text === '(') {\n            return preg_match('/^[\\\\p{L}_`\"]|[)\\\\]]$/u', $left->text) === 1\n                && !in_array(strtoupper($left->text), ['SELECT', 'AS', 'WHERE', 'AND', 'OR', 'NOT', 'IN', 'ON', 'VALUES', 'VALUE', 'RETURNING', 'HAVING', 'BY', 'UNION', 'INTERSECT', 'EXCEPT', 'ALL', 'DISTINCT', 'THEN', 'ELSE', 'WHEN', 'SET', 'DEFAULT', 'CHECK', 'FILTER', 'OVER', 'WITH'], true);\n        }\n        if ($left->text === '.' || $right->text === '.') {\n            return preg_match('/^[0-9]/', $left->text) !== 1 && preg_match('/^[0-9]/', $right->text) !== 1;\n        }\n        return false;\n    }\n}\nPHPUnit 10.5.64 by Sebastian Bergmann and contributors.\n\nRuntime:       PHP 8.5.8\nConfiguration: /Users/ab/Projects/ztd-query-php-worktrees/sql-semantics-versioned-language/packages/sql-semantics/phpunit.xml.dist\nRandom Seed:   1790154655\n\n.....E...............................                             37 / 37 (100%)\n <fg=cyan>tests/Unit/Serialization/Definition/Ownership/OwnedObjectsTest.php</>\n\n  <fg=blue> 43</> |         $sql = (new \\SqlSemantics\\Model\\Sql\\Printer())->print(OwnedObjects::role(new NamedRole('x\"y')));\n      | <fg=red>        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^</>\n  <fg=red>ERROR</>: Tests\\Unit\\Serialization\\Definition\\Ownership\\OwnedObjectsTest::testRoleQuotesIdentifierPunctuationWithoutChangingTheRole\n  Class \"SqlSemantics\\Model\\Sql\\Printer\" not found\n\n <error> Found 1 error in 1 test file </error>\n\n\nTime: 00:00.426, Memory: 76.97 MB\n\nThere was 1 error:\n\n1) Tests\\Unit\\Serialization\\Definition\\Ownership\\OwnedObjectsTest::testRoleQuotesIdentifierPunctuationWithoutChangingTheRole\nError: Class \"SqlSemantics\\Model\\Sql\\Printer\" not found\n\n/Users/ab/Projects/ztd-query-php-worktrees/sql-semantics-versioned-language/packages/sql-semantics/tests/Unit/Serialization/Definition/Ownership/OwnedObjectsTest.php:43\n\nERRORS!\nTests: 37, Assertions: 114, Errors: 1.\n   3) tests/Unit/Binding/Configuration/Role/PostgreSqlRolesTest.php\n   4) tests/Unit/Binding/Statement/Definition/Ownership/OwnedObjectsTest.php\n   5) tests/Unit/Model/Configuration/Role/SessionRoleTest.php\n   6) tests/Unit/Model/Statement/Definition/PostgreSql/Ownership/DropOwnedStatementTest.php\n   7) tests/Unit/Model/Statement/Definition/PostgreSql/Ownership/ReassignOwnedStatementTest.php\n   8) tests/Unit/Model/Definition/Ownership/OwnershipInvariantTest.php\n\nFixed 8 of 1410 files in 1.242 seconds, 70.00 MB memory used\n<?php\