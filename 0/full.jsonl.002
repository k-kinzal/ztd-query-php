{"timestamp":"2026-09-23T09:09:18.041Z","ordinal":18094,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0c2a9-e321-7e31-8c9d-08070b38ca84","turn_id":"01a0ccb0-75a7-7862-941a-ed4430a5b3b7","item":{"type":"CommandExecution","id":"exec-b89b939c-0107-45a7-8c26-d3b9401b2c9c","process_id":"38696","command":["/bin/zsh","-lc","cat > /tmp/semantics-ownership.py <<'PY'\nfrom pathlib import Path\nroot=Path.cwd()\ndef write(path,text):\n p=root/path;p.parent.mkdir(parents=True,exist_ok=True);p.write_text('<?php\\n\\ndeclare(strict_types=1);\\n\\n'+text.strip()+'\\n')\nwrite('src/Model/Configuration/Role/SessionRole.php',r'''\nnamespace SqlSemantics\\Model\\Configuration\\Role;\n\n/**\n * Identifies a session role by its lookup rule without resolving its runtime name.\n * @visibility public\n * @example Retaining the role lookup rule\n *     \\SqlSemantics\\Model\\Configuration\\Role\\SessionRole::CurrentUser->value // => 'CURRENT_USER'\n */\nenum SessionRole: string\n{\n    case CurrentRole = 'CURRENT_ROLE';\n    case CurrentUser = 'CURRENT_USER';\n    case SessionUser = 'SESSION_USER';\n}\n''')\nwrite('src/Model/Definition/Ownership/OwnershipInvariant.php',r'''\nnamespace SqlSemantics\\Model\\Definition\\Ownership;\n\nuse SqlSemantics\\Dialect;\nuse SqlSemantics\\Model\\Configuration\\Role\\NamedRole;\nuse SqlSemantics\\Model\\Configuration\\Role\\SessionRole;\nuse SqlSemantics\\Model\\Statement\\Origin;\nuse SqlSemantics\\Model\\Validation\\Collections;\nuse SqlSemantics\\Model\\Validation\\InvalidStructure;\n\n/**\n * Requires an explicit nonempty PostgreSQL owner selection.\n * @visibility SqlSemantics\n */\nfinal class OwnershipInvariant\n{\n    /**\n     * Rejects invalid dialects, lists, and role alternatives at construction time.\n     * @param non-empty-list<NamedRole|SessionRole> $owners Ownership selection\n     * @throws InvalidStructure\n     */\n    public static function owners(Origin $origin, array $owners): void\n    {\n        if ($origin->dialect !== Dialect::PostgreSql) {\n            throw new InvalidStructure('Owned-object selection requires PostgreSQL.');\n        }\n        Collections::alternatives(Collections::nonEmpty($owners), [NamedRole::class, SessionRole::class]);\n    }\n}\n''')\nfor name,desc,kind,extra,methods in [\n('DropOwnedStatement','Selects objects and privileges by their owners for removal.','Drop','public readonly DropBehavior $behavior = DropBehavior::Default,',r'''\n    /**\n     * Replaces dependent-object handling while retaining the owner selection.\n     */\n    public function withBehavior(DropBehavior $behavior): self\n    {\n        return $this->changed(new self($this->origin, $this->owners, $behavior));\n    }\n'''),\n('ReassignOwnedStatement','Selects owned objects and a required new owner for ownership transfer.','Reassign','public readonly NamedRole|SessionRole $newOwner,',r'''\n    /**\n     * Replaces the ownership destination without changing the source selection.\n     */\n    public function withNewOwner(NamedRole|SessionRole $newOwner): self\n    {\n        return $this->changed(new self($this->origin, $this->owners, $newOwner));\n    }\n''')]:\n isdrop=name=='DropOwnedStatement';prop='behavior' if isdrop else 'newOwner';sql='DROP OWNED BY alice, CURRENT_USER' if isdrop else 'REASSIGN OWNED BY alice TO SESSION_USER'\n text=r'''\nnamespace SqlSemantics\\Model\\Statement\\Definition\\PostgreSql\\Ownership;\n\nuse Override;\nuse SqlSemantics\\Model\\BoundStatement;\nuse SqlSemantics\\Model\\Configuration\\Role\\NamedRole;\nuse SqlSemantics\\Model\\Configuration\\Role\\SessionRole;\nUSE_BEHAVIOR\nuse SqlSemantics\\Model\\Definition\\Ownership\\OwnershipInvariant;\nuse SqlSemantics\\Model\\Statement\\Origin;\nuse SqlSemantics\\Model\\Statement\\StatementKind;\nuse SqlSemantics\\Model\\Validation\\InvalidStructure;\n\n/**\n * DESCRIPTION\n * @visibility public\n * @example Inspecting ownership selectors\n *     $statement = (new \\SqlSemantics\\Binder((new \\SqlSemantics\\SchemaBuilder(\\SqlSemantics\\Dialect::PostgreSql))->build()))->bind('SQL_INPUT');\n *     $statement->owners[0]->name // => 'alice'\n * @example Rejecting an empty ownership selection\n *     $origin = (new \\SqlSemantics\\Binder((new \\SqlSemantics\\SchemaBuilder(\\SqlSemantics\\Dialect::PostgreSql))->build()))->bind('SELECT 1')->origin;\n *     new \\SqlSemantics\\Model\\Statement\\Definition\\PostgreSql\\Ownership\\CLASSNAME($origin, []EXTRA_ARG); // throws \\SqlSemantics\\Model\\Validation\\InvalidStructure\n */\nfinal class CLASSNAME extends BoundStatement\n{\n    /**\n     * @param non-empty-list<NamedRole|SessionRole> $owners Roles whose objects are selected\n     * @throws InvalidStructure\n     */\n    public function __construct(\n        Origin $origin,\n        public readonly array $owners,\n        EXTRA_PROPERTY\n    ) {\n        OwnershipInvariant::owners($origin, $owners);\n        parent::__construct($origin);\n    }\n\n    #[Override]\n    protected function operation(): StatementKind\n    {\n        return StatementKind::KIND;\n    }\n\n    /**\n     * Retains the ownership request while replacing diagnostic provenance.\n     */\n    #[Override]\n    public function withOrigin(Origin $origin): static\n    {\n        return new self($origin, $this->owners, $this->PROP);\n    }\n\n    /**\n     * Replaces the source roles in a separately validated ownership request.\n     * @param non-empty-list<NamedRole|SessionRole> $owners Replacement selection\n     */\n    public function withOwners(array $owners): self\n    {\n        return $this->changed(new self($this->origin, $owners, $this->PROP));\n    }\nMETHODS\n}\n'''\n for a,b in {'USE_BEHAVIOR':'use SqlSemantics\\\\Model\\\\Definition\\\\DropBehavior;' if isdrop else '', 'DESCRIPTION':desc,'SQL_INPUT':sql,'CLASSNAME':name,'EXTRA_ARG':'' if isdrop else ', \\\\SqlSemantics\\\\Model\\\\Configuration\\\\Role\\\\SessionRole::CurrentUser','EXTRA_PROPERTY':extra,'KIND':kind,'PROP':prop,'METHOD