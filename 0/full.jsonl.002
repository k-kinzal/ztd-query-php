'\nfrom pathlib import Path\np=Path('src/Binding/Statement/Session/ExecutionBinder.php');t=p.read_text();a=t.index('return Statement\\\\Definition\\\\ForeignServers');b=t.index('            ?? Statement\\\\Maintenance\\\\IndexCaches',a);calls=t[a:b];t=t[:a]+'return Statement\\\\Definition\\\\DefinitionBinder::bind($origin, $statement, $context)\\n'+t[b:];p.write_text(t)\nbody='''<?php\n\ndeclare(strict_types=1);\n\nnamespace SqlSemantics\\\\Binding\\\\Statement\\\\Definition;\n\nuse SqlParser\\\\Parser\\\\Node;\nuse SqlSemantics\\\\Binding\\\\Query\\\\QueryContext;\nuse SqlSemantics\\\\Model\\\\BoundStatement;\nuse SqlSemantics\\\\Model\\\\Statement\\\\Origin;\n\n/**\n * Routes definition requests by their semantic object families.\n * @visibility SqlSemantics\n */\nfinal class DefinitionBinder\n{\n    /**\n     * Returns null for statements outside these named definition families.\n     */\n    public static function bind(Origin $origin, Node $statement, QueryContext $context): ?BoundStatement\n    {\n        CALLS;\n    }\n}\n'''.replace('CALLS',calls.replace('Statement\\\\Definition\\\\','').replace('Statement\\\\Routine\\\\','\\\\SqlSemantics\\\\Binding\\\\Statement\\\\Routine\\\\').rstrip());Path('src/Binding/Statement/Definition/DefinitionBinder.php').write_text(body)\nPY\ncomposer format > /tmp/semantics-server-format.log 2>&1\ncomposer loc-guard > /tmp/semantics-server-loc.log 2>&1\ncomposer tree-guard > /tmp/semantics-server-tree.log 2>&1"}],"source":"unified_exec_startup","status":"completed","stdout":"","stderr":"","aggregated_output":"","exit_code":0,"duration":{"secs":3,"nanos":272850750},"formatted_output":""},"started_at_ms":1790151842262,"completed_at_ms":1790151845535}}
