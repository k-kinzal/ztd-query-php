{"timestamp":"2026-09-23T09:17:22.260Z","ordinal":18222,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0c2a9-e321-7e31-8c9d-08070b38ca84","turn_id":"01a0ccb0-75a7-7862-941a-ed4430a5b3b7","item":{"type":"CommandExecution","id":"exec-3943016a-15e8-4655-8f40-0c04ef1d765e","process_id":"97630","command":["/bin/zsh","-lc","cat > /tmp/semantics-event-triggers.py <<'PY'\nfrom pathlib import Path\nroot=Path.cwd()\ndef write(path,text):\n p=root/path;p.parent.mkdir(parents=True,exist_ok=True);p.write_text('<?php\\n\\ndeclare(strict_types=1);\\n\\n'+text.strip()+'\\n')\nwrite('src/Model/Definition/Trigger/TriggerFiring.php',r'''\nnamespace SqlSemantics\\Model\\Definition\\Trigger;\n\n/**\n * Selects the replication contexts in which a PostgreSQL trigger fires.\n * @visibility public\n * @example Enabling a trigger for every replication role\n *     \\SqlSemantics\\Model\\Definition\\Trigger\\TriggerFiring::Always->value // => 'ENABLE ALWAYS'\n */\nenum TriggerFiring: string\n{\n    case Origin = 'ENABLE';\n    case Replica = 'ENABLE REPLICA';\n    case Always = 'ENABLE ALWAYS';\n    case Disabled = 'DISABLE';\n}\n''')\nwrite('src/Model/Definition/Trigger/EventTriggerInvariant.php',r'''\nnamespace SqlSemantics\\Model\\Definition\\Trigger;\n\nuse SqlSemantics\\Dialect;\nuse SqlSemantics\\Model\\Statement\\Origin;\nuse SqlSemantics\\Model\\Validation\\InvalidStructure;\n\n/**\n * Requires an unqualified PostgreSQL event-trigger identity.\n * @visibility SqlSemantics\n */\nfinal class EventTriggerInvariant\n{\n    /**\n     * Event triggers belong to the database rather than to a named relation.\n     * @throws InvalidStructure\n     */\n    public static function target(Origin $origin, string $name): void\n    {\n        if ($origin->dialect !== Dialect::PostgreSql || $name === '') {\n            throw new InvalidStructure('An event trigger requires PostgreSQL and a nonempty name.');\n        }\n    }\n}\n''')\nfor cls,desc,prop,typ,uses,guard,sql,example in [\n('AlterEventTriggerFiringStatement','Changes the replication contexts that can fire a named event trigger.','firing','TriggerFiring','use SqlSemantics\\\\Model\\\\Definition\\\\Trigger\\\\TriggerFiring;','', 'ALTER EVENT TRIGGER audit ENABLE REPLICA', \"$statement->firing->value // => 'ENABLE REPLICA'\"),\n('RenameEventTriggerStatement','Renames an event trigger with a required replacement identity.','newName','string','','        EventTriggerInvariant::target($origin, $newName);\\n','ALTER EVENT TRIGGER audit RENAME TO audit_ddl',\"$statement->newName // => 'audit_ddl'\"),\n('ChangeEventTriggerOwnerStatement','Transfers a named event trigger to a required role identity.','newOwner','NamedRole|SessionRole','use SqlSemantics\\\\Model\\\\Configuration\\\\Role\\\\NamedRole;\\nuse SqlSemantics\\\\Model\\\\Configuration\\\\Role\\\\SessionRole;','','ALTER EVENT TRIGGER audit OWNER TO CURRENT_USER',\"$statement->newOwner->value // => 'CURRENT_USER'\")]:\n text=r'''\nnamespace SqlSemantics\\Model\\Statement\\Definition\\PostgreSql\\Trigger;\n\nuse Override;\nuse SqlSemantics\\Model\\BoundStatement;\nIMPORTS\nuse SqlSemantics\\Model\\Definition\\Trigger\\EventTriggerInvariant;\nuse SqlSemantics\\Model\\Statement\\Origin;\nuse SqlSemantics\\Model\\Statement\\StatementKind;\nuse SqlSemantics\\Model\\Validation\\InvalidStructure;\n\n/**\n * DESCRIPTION\n * @visibility public\n * @example Reading the required alteration operand\n *     $statement = (new \\SqlSemantics\\Binder((new \\SqlSemantics\\SchemaBuilder(\\SqlSemantics\\Dialect::PostgreSql))->build()))->bind('SQL_INPUT');\n *     EXAMPLE\n */\nfinal class CLASSNAME extends BoundStatement\n{\n    /**\n     * @throws InvalidStructure\n     */\n    public function __construct(\n        Origin $origin,\n        public readonly string $name,\n        public readonly TYPE $PROP,\n    ) {\n        EventTriggerInvariant::target($origin, $name);\nGUARD        parent::__construct($origin);\n    }\n\n    #[Override]\n    protected function operation(): StatementKind\n    {\n        return StatementKind::Alter;\n    }\n\n    /**\n     * Retains the operation while replacing diagnostic provenance.\n     */\n    #[Override]\n    public function withOrigin(Origin $origin): static\n    {\n        return new self($origin, $this->name, $this->PROP);\n    }\n\n    /**\n     * Replaces the target event-trigger identity without applying the alteration.\n     */\n    public function withName(string $name): self\n    {\n        return $this->changed(new self($this->origin, $name, $this->PROP));\n    }\n\n    /**\n     * Replaces the required alteration operand in a separately validated statement.\n     */\n    public function withMETHOD(TYPE $PROP): self\n    {\n        return $this->changed(new self($this->origin, $this->name, $PROP));\n    }\n}\n'''\n for a,b in {'IMPORTS':uses,'DESCRIPTION':desc,'SQL_INPUT':sql,'EXAMPLE':example,'CLASSNAME':cls,'TYPE':typ,'PROP':prop,'GUARD':guard,'METHOD':prop[0].upper()+prop[1:]}.items():text=text.replace(a,b)\n write('src/Model/Statement/Definition/PostgreSql/Trigger/'+cls+'.php',text)\ns=(root/'src/Model/Statement/Definition/PostgreSql/DropForeignServersStatement.php').read_text();s=s.replace('namespace SqlSemantics\\\\Model\\\\Statement\\\\Definition\\\\PostgreSql;', 'namespace SqlSemantics\\\\Model\\\\Statement\\\\Definition\\\\PostgreSql\\\\Trigger;').replace('Foreign\\\\ServerInvariant','Trigger\\\\EventTriggerInvariant').replace('ServerInvariant::','EventTriggerInvariant::').replace('DropForeignServersStatement','DropEventTriggersStatement').replace('foreign servers','event triggers').replace('DROP SERVER','DROP EVENT TRIGGER').replace('Definition\\\\PostgreSql\\\\DropEventTriggersStatement','Definition\\\\PostgreSql\\\\Trigger\\\\DropEventTriggersStatement');write('src/Model/Statement/Definition/PostgreSql/Trigger/DropEventTriggersStatement.php',s.split('declare(strict_types=1);',1)[1])\nwrite('src/Binding/Statement/Definition/Trigger/EventTriggerBinder.